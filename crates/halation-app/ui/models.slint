    none: string,
    capture: string,
    capture_none: string,
    cancel: string,
    layout: string,
    destination: string,
    results: string,
    results_empty: string,
    reveal: string,
    crop_hint: string,
    back_send_note: string,
    results_note: string,
    sound_note: string,
    keys_hint: string,
    frame_of: string,
    frame_short: string,
    time_of: string,
    sharpest: string,
    saved: string,
    capture_progress: string,
    selected_count: string,
    reading: string,
    analysing: string,
    finding: string,
    captured_one: string,
    capture_failed: string,
    open_failed: string,
    playback_failed: string,
    timeline_missing: string,
    install_done: string,
    install_failed: string,
    cancelled: string,
    back_one: string,
    forward_one: string,
    video_preview: string,
    timeline: string,
    crop: string,
    select: string,
    deselect: string,
    remove: string,
    details: string,
    layout_16_9: string,
    layout_9_16: string,
    layout_1_1: string,
    layout_4_5: string,
    layout_original_label: string,
    layout_original: string,
    layout_16_9_detail: string,
    layout_9_16_detail: string,
    layout_1_1_detail: string,
    layout_4_5_detail: string,
    destination_library: string,
    destination_image: string,
    library_detail: string,
    image_detail: string,
    result_detail: string,
    results_note_title: string,
}

export struct LibraryRow {
    id: string,
    name: string,
    path: string,
    missing: bool,
    // "Image", "Audio", "Video" or "File", from the extension
    kind: string,
}

export struct JobRow {
    id: string,
    name: string,
    detail: string,
    state: string,
    progress: float,
    has-progress: bool,
    cancellable: bool,
    finished: bool,
    failed: bool,
}

export struct RecentItem {
    id: string,
    name: string,
    folder: string,
}

export struct SectionRow {
    id: string,
    name: string,
    kind: string,
    count: int,
    missing: bool,
    selected: bool,
}

export struct ItemRow {
    name: string,
    detail: string,
}

// Settings shown on the Settings page; Rust owns and saves them (settings.rs). Choices are indexes into the
// option lists the page shows.
export struct Prefs {
    language: int,
    reduce-motion: bool,
    show-dock: bool,
    notify: bool,
    dock-mode: int,
    dock-activity: bool,
    open-window: int,
    artist: string,
    youtube: string,
    spotify: string,
    soundcloud: string,
    instagram: string,
    tiktok: string,
    save-mode: int,
    video-template: string,
    image-template: string,
    processing: int,
    use-gpu: bool,
    vocal-device: int,
    cpu-jobs: int,
    gpu-jobs: int,
    downloads: int,
    minimized: int,
    budget: int,
    updates: int,
    whats-new: bool,
    theme: int,
    accent-hue: int,
}

// A downloadable component as Settings > Tools lists it
export struct ComponentRow {
    name: string,
    size: string,
}

// A folder of the beta's profile, as Settings > About lists it
export struct FolderRow {
    key: string,
    name: string,
    detail: string,
    path: string,
}
