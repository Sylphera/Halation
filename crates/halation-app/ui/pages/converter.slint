import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ConvertRow, FormatRow } from "../models.slint";
import { AppButton } from "../components/button.slint";
import { ToolIcon } from "../icons.slint";
import { Motion, Curve } from "../motion.slint";

// The approved tool frame. All media/job state is supplied by the Rust controller.
export component ConverterPage inherits Rectangle {
    in property <[ConvertRow]> items;
    in property <[FormatRow]> formats;
    in property <string> title;
    in property <string> summary;
    in property <string> message;
    in property <string> output;
    in property <image> preview;
    in property <bool> has-preview: false;
    in property <bool> busy: false;
    in property <bool> needs-ffmpeg: true;
    in property <bool> completed: false;
    in property <bool> left-open: false;
    in property <bool> inspector-open: true;
    in property <float> progress: 0;
    in property <string> progress-label;
    callback action(string);
    callback select(int);
    callback target(string);
    callback file-dropped(data-transfer);
    background: Theme.canvas-deep;

    property <length> files-width: root.left-open ? 220px : 0px;
    property <length> inspector-width: root.inspector-open ? 280px : 0px;
    animate files-width, inspector-width { duration: Motion.panel; easing: Curve.ease; }

    if root.files-width > 0px : Rectangle {
        accessible-role: groupbox;
        accessible-label: "Converter files";
        x: 0px; y: 0px;
        width: root.files-width;
        height: parent.height;
        background: Theme.chrome;
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.line; }
        VerticalLayout {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            spacing: 0px;
            Rectangle {
                height: 36px;
                Text { x: 16px; height: parent.height; text: "Files"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
            }
            ListView {
                for item in root.items : FocusScope {
                    height: 60px;
                    focus-on-tab-navigation: true;
                    accessible-role: button;
                    accessible-label: item.name + ", " + item.state;
                    accessible-action-default => { root.select(item.index); }
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) { root.select(item.index); accept } else { reject }
                    }
                    Rectangle { background: item.selected ? Theme.control-active : row-touch.has-hover ? Theme.control-hover : transparent; }
                    VerticalLayout {
                        padding-left: 14px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; spacing: 3px;
                        Text { text: item.name; color: Theme.text; font-size: Theme.font-body; overflow: elide; }
                        Text { text: item.target + (item.target != "" ? " · " : "") + item.state; color: item.failed ? Theme.danger : Theme.subtle; font-size: Theme.font-caption; overflow: elide; }
                    }
                    row-touch := TouchArea { clicked => { root.select(item.index); } }
                }
            }
            HorizontalLayout {
                height: 48px; padding: 8px; spacing: 6px;
                AppButton { text: "Add files"; small: true; enabled: !root.busy; clicked => { root.action("add"); } }
                AppButton { text: "Clear"; small: true; quiet: true; enabled: !root.busy; clicked => { root.action("clear"); } }
            }
        }
    }

    Rectangle {
        x: root.files-width;
        accessible-role: groupbox;
        accessible-label: "Converter canvas";
        y: 0px;
        width: parent.width - root.files-width - root.inspector-width;
        height: parent.height;
        VerticalLayout {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            padding: 0px; spacing: 0px;
            Rectangle {
                horizontal-stretch: 1; vertical-stretch: 1;
                if root.has-preview : Image {
                    x: 24px; y: 24px; width: parent.width - 48px; height: parent.height - 48px;
                    source: root.preview; image-fit: contain;
                }
                if !root.has-preview : VerticalLayout {
                    padding: 24px; spacing: 16px; alignment: center;
                    Rectangle {
                        height: 56px;
                        ToolIcon { x: (parent.width - self.width) / 2; size: 40px; name: root.items.length == 0 ? "upload" : "convert"; tint: Theme.muted; }
                    }
                    Text { text: root.items.length == 0 ? "Drop media here" : root.title; color: Theme.text; font-size: Theme.font-heading; horizontal-alignment: center; overflow: elide; }
                    Text { text: root.items.length == 0 ? "Images, audio and video. Processed locally." : root.summary; color: Theme.subtle; wrap: word-wrap; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center; spacing: 8px;
                        AppButton { text: root.items.length == 0 ? "Browse files" : "Add files"; enabled: !root.busy; clicked => { root.action("add"); } }
                        AppButton { text: "Add folder"; quiet: true; enabled: !root.busy; clicked => { root.action("folder"); } }
                    }
                }
                DropArea {
                    can-drop(event) => { root.busy ? DragAction.none : DragAction.copy }
                    dropped(event) => { root.file-dropped(event.data); event.proposed-action }
                }
            }
            if root.message != "" : Rectangle {
                height: 56px; background: Theme.chrome;
                Text { x: 12px; y: 6px; width: parent.width - 24px; height: 44px; text: root.message; color: Theme.muted; wrap: word-wrap; overflow: elide; }
            }
            if root.progress-label != "" : Rectangle {
                height: 28px; background: Theme.chrome;
                Text { x: 12px; width: parent.width - 24px; height: 24px; text: root.progress-label; color: Theme.muted; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
                Rectangle { y: parent.height - 3px; width: parent.width * root.progress; height: 3px; background: Theme.accent; }
            }
            Rectangle {
                height: 40px; background: Theme.chrome;
                Rectangle { height: 1px; width: parent.width; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 8px;
                    Text { text: root.busy ? "Working…" : root.has-preview ? root.summary : root.items.length == 0 ? "No file selected" : root.items.length + " file(s)"; color: Theme.subtle; vertical-alignment: center; overflow: elide; }
                    Rectangle { horizontal-stretch: 1; }
                    if root.completed : VerticalLayout {
                        alignment: center;
                        AppButton { text: "Show in folder"; quiet: true; small: true; clicked => { root.action("reveal"); } }
                    }
                }
            }
        }
    }

    if root.inspector-open : Rectangle {
        accessible-role: groupbox;
        accessible-label: "Converter output";
        x: parent.width - root.inspector-width;
        y: 0px;
        width: root.inspector-width;
        height: parent.height;
        background: Theme.chrome;
        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Theme.line; }
        VerticalLayout {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            spacing: 0px;
            Rectangle {
                height: 36px;
                Text { x: 16px; height: parent.height; text: "Output"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
            }
            if root.needs-ffmpeg : Rectangle {
                height: 104px;
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    Text { text: "Audio and video need FFmpeg"; color: Theme.muted; wrap: word-wrap; }
                    AppButton { text: "Install FFmpeg"; small: true; enabled: !root.busy; clicked => { root.action("install"); } }
                    Text { text: "Downloaded only when you choose to install."; color: Theme.subtle; font-size: Theme.font-caption; wrap: word-wrap; }
                }
            }
            Rectangle {
                height: 32px;
                Text { x: 16px; height: parent.height; text: "Convert to"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
            }
            ListView {
                for format in root.formats : FocusScope {
                    height: 64px;
                    focus-on-tab-navigation: true;
                    accessible-role: button;
                    accessible-label: "Convert to " + format.name;
                    accessible-action-default => { if (!root.busy) { root.target(format.id); } }
                    key-pressed(event) => {
                        if (!root.busy && (event.text == Key.Return || event.text == Key.Space)) { root.target(format.id); accept } else { reject }
                    }
                    Rectangle { background: format.selected ? Theme.control-active : format-touch.has-hover ? Theme.control-hover : transparent; }
                    VerticalLayout {
                        padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px; spacing: 4px;
                        Text { text: (format.selected ? "●  " : "○  ") + format.name + (format.audio ? " · Audio only" : ""); color: Theme.text; font-weight: 500; }
                        Text { text: format.detail; color: Theme.subtle; font-size: Theme.font-caption; wrap: word-wrap; overflow: elide; }
                    }
                    format-touch := TouchArea { enabled: !root.busy; clicked => { root.target(format.id); } }
                }
            }
            Rectangle {
                height: 76px;
                Rectangle { width: parent.width; height: 1px; background: Theme.line; }
                VerticalLayout {
                    padding: 12px; spacing: 4px;
                    Text { text: "Save location"; color: Theme.muted; font-weight: 600; }
                    Text { text: root.completed ? root.output : "Uses Settings → Files. Originals are never modified."; color: Theme.subtle; wrap: word-wrap; overflow: elide; font-size: Theme.font-caption; }
                }
            }
        }
    }
}
