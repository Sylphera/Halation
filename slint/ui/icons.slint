// Tool, Library, Settings, Upload, Search and Warning icons are the Lucide SVGs the Tauri app already uses
// (ISC licence, see NOTICE.md): reused as identity assets, tinted with `colorize`. Home and Jobs have no counterpart
// there and stay drawn as paths.
component IconHome inherits Path {
    in property <color> tint: #f4f4f5;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M3 11 L12 3 L21 11 M5 10 L5 21 L19 21 L19 10 M9 21 L9 14 L15 14 L15 21";
    stroke: tint;
    stroke-width: 1.7px;
    fill: transparent;
}

component IconJobs inherits Path {
    in property <color> tint: #f4f4f5;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M4 12 L8 12 L10 6 L14 18 L16 12 L20 12";
    stroke: tint;
    stroke-width: 1.7px;
    fill: transparent;
}

export component ToolIcon inherits Rectangle {
    in property <string> name: "download";
    in property <color> tint: #f4f4f5;
    width: 18px;
    height: 18px;

    if name == "mark" : Image {
        source: @image-url("../assets/halation-mark.png");
        width: 26px;
        height: 13px;
        image-fit: contain;
    }
    if name == "home" : IconHome { tint: root.tint; }
    if name == "download" : Image {
        source: @image-url("icons/download.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "convert" : Image {
        source: @image-url("icons/convert.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "vocal" : Image {
        source: @image-url("icons/vocal.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "visualizer" : Image {
        source: @image-url("icons/visualizer.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "grade" : Image {
        source: @image-url("icons/grade.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "cover" : Image {
        source: @image-url("icons/cover.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "removebg" : Image {
        source: @image-url("icons/removebg.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "upscale" : Image {
        source: @image-url("icons/upscale.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "interp" : Image {
        source: @image-url("icons/interp.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "framegrab" : Image {
        source: @image-url("icons/framegrab.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "library" : Image {
        source: @image-url("icons/library.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "jobs" : IconJobs { tint: root.tint; }
    if name == "settings" : Image {
        source: @image-url("icons/settings.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "upload" : Image {
        source: @image-url("icons/upload.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "search" : Image {
        source: @image-url("icons/search.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
    if name == "warning" : Image {
        source: @image-url("icons/warning.svg");
        colorize: root.tint;
        width: parent.width;
        height: parent.height;
    }
}
