import { Theme } from "../theme.slint";
import { AppButton } from "../components/button.slint";
import { ToggleSwitch } from "../components/toggle.slint";
import { PageHeader } from "../components/page-header.slint";
import { Notice } from "../components/notice.slint";

// One label and value line of a settings group
component InfoRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "";
    in property <bool> last: false;
    height: 44px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        Text {
            text: root.label;
            color: Theme.muted;
            font-size: Theme.font-label;
            vertical-alignment: center;
            width: 140px;
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: Theme.font-label;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    if !root.last : Rectangle {
        x: 16px;
        y: parent.height - 1px;
        width: parent.width - 32px;
        height: 1px;
        background: Theme.border;
    }
}

// Caption above a settings group
component GroupTitle inherits Text {
    color: Theme.text;
    font-size: Theme.font-body;
    font-weight: 600;
}

export component SettingsPage inherits Rectangle {
    in property <bool> reduced-motion: false;
    in property <bool> settings-writable: true;
    in property <int> library-limit: 2000;
    in property <int> schema-version: 1;
    in property <string> profile-path: "";
    in property <string> build-label: "";
    in property <string> error: "";
    in property <string> notice: "";
    in property <duration> motion-duration: 160ms;

    callback set-reduced-motion(bool);
    callback reset-settings();
    callback dismiss-notice();

    // Settings read best on a narrower measure; it keeps the column's left edge.
    property <length> pad-x: Theme.side-padding(root.width);
    property <length> measure: min(840px, root.width - 2 * root.pad-x);

    background: transparent;

    VerticalLayout {
        padding-left: root.pad-x;
        padding-right: root.width - root.pad-x - root.measure;
        padding-top: Theme.top-padding(root.height);
        padding-bottom: 20px;
        spacing: 0px;

        PageHeader {
            title: "Settings";
            subtitle: "Kept in the beta's own profile. The released app's settings are never read or changed.";
            AppButton {
                text: "Reset settings";
                motion-duration: root.motion-duration;
                clicked => { root.reset-settings(); }
            }
        }

        if root.error != "" : VerticalLayout {
            padding-top: 16px;
            Notice {
                text: root.error;
                error: true;
            }
        }

        if root.notice != "" : VerticalLayout {
            padding-top: 16px;
            Notice {
                text: root.notice;
                dismiss => { root.dismiss-notice(); }
            }
        }

        Rectangle { height: 24px; }
        GroupTitle { text: "Motion"; }
        Rectangle { height: 8px; }

        Rectangle {
            height: 72px;
            border-radius: Theme.radius-panel;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 16px;
                VerticalLayout {
                    spacing: 3px;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "Reduce motion";
                        color: Theme.text;
                        font-size: Theme.font-body;
                        font-weight: 600;
                    }
                    Text {
                        text: "Hover and state changes switch instantly instead of fading.";
                        color: Theme.subtle;
                        font-size: Theme.font-caption;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ToggleSwitch {
                        checked: root.reduced-motion;
                        enabled: root.settings-writable;
                        accessible-name: "Reduce motion";
                        motion-duration: root.motion-duration;
                        toggled(value) => { root.set-reduced-motion(value); }
                    }
                }
            }
        }

        Rectangle { height: 24px; }
        GroupTitle { text: "Profile"; }
        Rectangle { height: 8px; }

        Rectangle {
            border-radius: Theme.radius-panel;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                InfoRow {
                    label: "Profile folder";
                    value: root.profile-path;
                }
                InfoRow {
                    label: "Settings format";
                    value: "Version " + root.schema-version + ", saved atomically; damaged files are never overwritten";
                }
                InfoRow {
                    label: "Library limit";
                    value: root.library-limit + " references";
                }
                InfoRow {
                    label: "Build";
                    value: root.build-label;
                    last: true;
                }
            }
        }

        Rectangle { height: 24px; }
        GroupTitle { text: "Licences"; }
        Rectangle { height: 8px; }

        Text {
            text: "Halation is GPL-3.0-or-later. Slint 1.18.1 is used under its GPLv3-compatible option. Skia is BSD-3-Clause; skia-safe, winit and the other Rust dependencies keep their own licences.";
            color: Theme.subtle;
            font-size: Theme.font-caption;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }
    }
}
