import { Theme } from "../theme.slint";
import { ToolIcon } from "../icons.slint";

// Switch: 34 x 20, lavender when on
export component Toggle inherits FocusScope {
    in property <bool> checked: false;
    in property <string> label: "";
    in property <duration> motion-duration: 160ms;
    callback toggled(bool);

    width: 34px;
    height: 20px;
    focus-on-tab-navigation: true;
    accessible-role: checkbox;
    accessible-checked: checked;
    accessible-label: label;
    accessible-action-default => {
        if (root.enabled) {
            toggled(!checked);
        }
    }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == Key.Space) {
            if (root.enabled) {
                toggled(!checked);
            }
            accept
        } else {
            reject
        }
    }

    Rectangle {
        border-radius: 10px;
        background: root.checked ? Theme.accent : Theme.line-strong;
        border-width: root.has-focus ? 2px : 0px;
        border-color: Theme.text;
        opacity: root.enabled ? 1 : 0.45;
        animate background { duration: root.motion-duration; easing: ease-out; }
    }
    Rectangle {
        x: root.checked ? parent.width - 17px : 3px;
        y: 3px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.checked ? Theme.chrome : Theme.text;
        animate x { duration: root.motion-duration; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.focus();
            root.toggled(!root.checked);
        }
    }
}

// A labelled row with a switch at the far right
export component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <duration> motion-duration: 160ms;
    callback toggled(bool);
    height: 30px;
    Text {
        x: 0px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: Theme.muted;
        font-size: Theme.font-body;
    }
    Toggle {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        label: root.label;
        checked: root.checked;
        motion-duration: root.motion-duration;
        toggled(value) => { root.toggled(value); }
    }
}

// Drop-down: the current choice and a caret; the choices open in a popup below
export component Select inherits FocusScope {
    in property <[string]> options;
    in property <int> current: 0;
    in property <string> label: "";
    callback chosen(int);

    height: 32px;
    focus-on-tab-navigation: true;
    accessible-role: combobox;
    accessible-label: label;
    accessible-value: root.options[root.current];
    accessible-action-default => { popup.show(); }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == Key.Space) {
            popup.show();
            accept
        } else if (event.text == Key.DownArrow && root.current < root.options.length - 1) {
            root.chosen(root.current + 1);
            accept
        } else if (event.text == Key.UpArrow && root.current > 0) {
            root.chosen(root.current - 1);
            accept
        } else {
            reject
        }
    }

    Rectangle {
        border-radius: Theme.radius-control;
        background: touch.has-hover ? Theme.control-hover : Theme.control;
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? Theme.accent : Theme.line-strong;
    }
    Text {
        x: 10px;
        width: parent.width - 34px;
        y: (parent.height - self.height) / 2;
        text: root.options[root.current];
        color: Theme.text;
        font-size: Theme.font-body;
        font-weight: 500;
        overflow: elide;
    }
    Path {
        x: parent.width - 20px;
        y: (parent.height - self.height) / 2;
        width: 9px;
        height: 5px;
        viewbox-width: 9;
        viewbox-height: 5;
        commands: "M0 0 L9 0 L4.5 5 Z";
        fill: Theme.subtle;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.focus();
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            border-radius: Theme.radius-overlay;
            background: Theme.control;
            border-width: 1px;
            border-color: Theme.line-strong;
            VerticalLayout {
                padding: 4px;
                for option[index] in root.options : Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-control;
                    background: option-touch.has-hover ? Theme.control-active : transparent;
                    Text {
                        x: 8px;
                        y: (parent.height - self.height) / 2;
                        text: option;
                        color: index == root.current ? Theme.text : Theme.muted;
                        font-size: Theme.font-body;
                        font-weight: index == root.current ? 600 : 400;
                    }
                    option-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.chosen(index); }
                    }
                }
            }
        }
    }
}

// Single-line text field; the value is handed back when Enter is pressed or the field loses focus
export component Field inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> mono: false;
    callback committed(string);

    height: 32px;
    border-radius: Theme.radius-control;
    background: Theme.control;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line-strong;

    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        single-line: true;
        vertical-alignment: center;
        text: root.value;
        color: Theme.text;
        font-size: Theme.font-body;
        font-family: root.mono ? "Consolas" : "Inter";
        accessible-role: text-input;
        accessible-label: root.label;
        accepted => { root.committed(self.text); }
        changed has-focus => {
            if (!self.has-focus && self.text != root.value) {
                root.committed(self.text);
            }
        }
    }
    if input.text == "" : Text {
        x: 10px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        color: Theme.subtle;
        font-size: Theme.font-body;
    }
}

// Label above a control
export component Labelled inherits VerticalLayout {
    in property <string> text;
    spacing: 6px;
    Text {
        text: root.text;
        color: Theme.muted;
        font-size: Theme.font-body;
    }
    @children
}

// Help line under a control
export component Help inherits Text {
    color: Theme.subtle;
    font-size: Theme.font-small;
    wrap: word-wrap;
}

// Small rounded tag: "Beta", "Always on", "Missing: …"
export component Tag inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.activity;
    // Widest the tag may grow; longer text is elided
    in property <length> limit: 2000px;
    height: 20px;
    width: min(root.limit, tag-text.preferred-width + 16px);
    border-radius: 4px;
    background: ink.transparentize(88%);
    border-width: 1px;
    border-color: ink.transparentize(55%);
    tag-text := Text {
        x: 8px;
        width: parent.width - 16px;
        overflow: elide;
        y: (parent.height - self.height) / 2;
        text: root.text;
        color: root.ink;
        font-size: 11.5px;
        font-weight: 500;
    }
}

// A group of settings: its heading, then cells. Groups follow each other with 28 px between them.
export component Group inherits VerticalLayout {
    in property <string> title;
    spacing: 0px;
    padding-bottom: 28px;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.font-title;
        font-weight: 600;
    }
    Rectangle { height: 8px; }
    @children
}

// One setting: a 1 px line above, the name and an optional help line on the left, its control on the right
export component Cell inherits Rectangle {
    in property <string> name;
    in property <string> help: "";
    min-height: 48px;
    preferred-height: max(48px, body.preferred-height);
    // Cells of a pair share the width equally, whatever their text
    preferred-width: 0px;
    min-width: 0px;
    horizontal-stretch: 1;
    Rectangle {
        y: 0px;
        height: 1px;
        background: Theme.line;
    }
    body := HorizontalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.name;
                color: Theme.text;
                font-size: Theme.font-body;
                overflow: elide;
            }
            if root.help != "" : Text {
                text: root.help;
                color: Theme.subtle;
                font-size: Theme.font-caption;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// Two cells side by side, 32 px apart; an empty slot keeps the left one at half width
export component Pair inherits HorizontalLayout {
    spacing: 32px;
    @children
}

// Content that takes the whole width of a group (a list, a choice of cards), with the cell's line above
export component Wide inherits VerticalLayout {
    spacing: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    Rectangle {
        height: 1px;
        background: Theme.line;
    }
    @children
}

// Search field of the top bar: 240 px, a magnifier, the text and a placeholder
export component SearchField inherits Rectangle {
    in property <string> placeholder;
    in property <string> label;
    in-out property <string> text;
    callback edited(string);
    callback accepted(string);
    width: 240px;
    height: 28px;
    border-radius: Theme.radius-control;
    background: Theme.control;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line-strong;
    ToolIcon {
        x: 9px;
        y: (parent.height - self.height) / 2;
        name: "search";
        size: 14px;
        tint: Theme.subtle;
    }
    input := TextInput {
        x: 30px;
        width: parent.width - 40px;
        height: parent.height;
        single-line: true;
        vertical-alignment: center;
        text <=> root.text;
        color: Theme.text;
        font-size: Theme.font-small;
        accessible-role: text-input;
        accessible-label: root.label;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
    }
    if root.text == "" : Text {
        x: 30px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        color: Theme.subtle;
        font-size: Theme.font-small;
    }
}
