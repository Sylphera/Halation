export struct ToolItem {
    id: string,
    name: string,
    icon: string,
    summary: string,
    group: int,
    beta: bool,
    enabled: bool,
    // Components it still needs, as "Missing: …" shows them; empty when nothing is missing
    missing: string,
    available: bool,
    reason: string,
}

export struct ConvertRow {
    index: int,
    name: string,
    detail: string,
    state: string,
    target: string,
    selected: bool,
    failed: bool,
    // It can leave the list: not converting or queued right now
    removable: bool,
}

export struct FormatRow {
    id: string,
    name: string,
    detail: string,
    selected: bool,
    audio: bool,
    // The first of video's audio-only outputs: shows the "Audio only" caption above it
    header: bool,
    // The suggested output (the first of the curated list)
    recommended: bool,
    // The consequence line (§4.5 of the spec): empty when there is nothing to say
    note: string,
}

export struct LibraryRow {
    id: string,
    name: string,
    path: string,
    missing: bool,
    // "Image", "Audio", "Video" or "File", from the extension
    kind: string,
}

export struct JobRow {
    id: string,
    name: string,
    detail: string,
    state: string,
    progress: float,
    has-progress: bool,
    cancellable: bool,
    finished: bool,
    failed: bool,
}

export struct RecentItem {
    id: string,
    name: string,
    folder: string,
}

export struct SectionRow {
    id: string,
    name: string,
    kind: string,
    count: int,
    missing: bool,
    selected: bool,
}

export struct ItemRow {
    name: string,
    detail: string,
}

// Settings shown on the Settings page; Rust owns and saves them (settings.rs). Choices are indexes into the
// option lists the page shows.
export struct Prefs {
    language: int,
    reduce-motion: bool,
    show-dock: bool,
    notify: bool,
    dock-mode: int,
    dock-activity: bool,
    open-window: int,
    artist: string,
    youtube: string,
    spotify: string,
    soundcloud: string,
    instagram: string,
    tiktok: string,
    save-mode: int,
    video-template: string,
    image-template: string,
    processing: int,
    use-gpu: bool,
    vocal-device: int,
    cpu-jobs: int,
    gpu-jobs: int,
    downloads: int,
    minimized: int,
    budget: int,
    updates: int,
    whats-new: bool,
    theme: int,
    accent-hue: int,
}

// A downloadable component as Settings > Tools lists it
export struct ComponentRow {
    name: string,
    size: string,
}

// A folder of the beta's profile, as Settings > About lists it
export struct FolderRow {
    key: string,
    name: string,
    detail: string,
    path: string,
}
