import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ConvertRow, FormatRow } from "../models.slint";
import { AppButton } from "../components/button.slint";
import { ToolIcon } from "../icons.slint";
import { RoundButton, Scrubber, Transport } from "../components/media.slint";
import { Motion, Curve } from "../motion.slint";

// The approved tool frame. All media/job state is supplied by the Rust controller.
export component ConverterPage inherits Rectangle {
    in property <[ConvertRow]> items;
    in property <[FormatRow]> formats;
    in property <string> title;
    in property <string> summary;
    in property <string> message;
    in property <string> output;
    in property <image> preview;
    in property <bool> has-preview: false;
    in property <bool> busy: false;
    in property <bool> needs-ffmpeg: true;
    in property <bool> completed: false;
    in property <bool> left-open: false;
    in property <bool> inspector-open: true;
    in property <float> progress: 0;
    in property <string> progress-label;
    // Audio preview: the waveform as a vector envelope (`wave-bins` × 2 view box, empty while it is computed), the
    // position heard (0..1) and the clock. Rust owns playback; the page only shows it and asks for seeks.
    in property <bool> audio: false;
    in property <string> wave;
    in property <float> wave-bins: 480;
    in property <bool> playing: false;
    in property <float> position: 0;
    in property <string> clock;
    // Video preview: the picture (`preview`) plays with the same transport and a seek bar
    in property <bool> video: false;
    in property <float> volume: 1;
    callback action(string);
    callback seek(float);
    callback volume-changed(float);
    callback remove(int);
    callback select(int);
    callback target(string);
    callback file-dropped(data-transfer);
    background: Theme.canvas-deep;

    property <length> files-width: root.left-open ? 220px : 0px;
    property <length> inspector-width: root.inspector-open ? 280px : 0px;
    animate files-width, inspector-width { duration: Motion.panel; easing: Curve.ease; }

    if root.files-width > 0px : Rectangle {
        accessible-role: groupbox;
        accessible-label: "Converter files";
        x: 0px; y: 0px;
        width: root.files-width;
        height: parent.height;
        background: Theme.chrome;
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.line; }
        VerticalLayout {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            spacing: 0px;
            Rectangle {
                height: 36px;
                Text { x: 16px; height: parent.height; text: "Files"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
            }
            ListView {
                for item in root.items : FocusScope {
                    height: 60px;
                    focus-on-tab-navigation: true;
                    accessible-role: button;
                    accessible-label: item.name + ", " + item.state;
                    accessible-action-default => { root.select(item.index); }
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) { root.select(item.index); accept } else { reject }
                    }
                    Rectangle { background: item.selected ? Theme.control-active : row-touch.has-hover ? Theme.control-hover : transparent; }
                    VerticalLayout {
                        padding-left: 14px; padding-right: 40px; padding-top: 8px; padding-bottom: 8px; spacing: 3px;
                        Text { text: item.name; color: Theme.text; font-size: Theme.font-body; overflow: elide; }
                        Text { text: item.target + (item.target != "" ? " · " : "") + item.state; color: item.failed ? Theme.danger : Theme.subtle; font-size: Theme.font-caption; overflow: elide; }
                    }
                    row-touch := TouchArea { clicked => { root.select(item.index); } }
                    // Removes the file from the list (never from disk); hidden while its conversion runs
                    if item.removable : Rectangle {
                        x: parent.width - 34px; y: (parent.height - 24px) / 2; width: 24px; height: 24px;
                        opacity: row-touch.has-hover || item.selected || close-touch.has-hover ? 1 : 0;
                        border-radius: 12px;
                        background: close-touch.pressed ? Theme.press-fill : close-touch.has-hover ? Theme.hover-fill : transparent;
                        accessible-role: button;
                        accessible-label: "Remove " + item.name;
                        accessible-action-default => { root.remove(item.index); }
                        Path {
                            x: 7px; y: 7px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10;
                            commands: "M1 1 L9 9 M9 1 L1 9"; stroke: Theme.muted; stroke-width: 1.5px; fill: transparent;
                        }
                        close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.remove(item.index); } }
                    }
                }
            }
            HorizontalLayout {
                height: 48px; padding: 8px; spacing: 6px;
                AppButton { text: "Add files"; small: true; enabled: !root.busy; clicked => { root.action("add"); } }
                AppButton { text: "Clear"; small: true; quiet: true; enabled: !root.busy; clicked => { root.action("clear"); } }
            }
        }
    }

    Rectangle {
        x: root.files-width;
        accessible-role: groupbox;
        accessible-label: "Converter canvas";
        y: 0px;
        width: parent.width - root.files-width - root.inspector-width;
        height: parent.height;
        VerticalLayout {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            padding: 0px; spacing: 0px;
            Rectangle {
                horizontal-stretch: 1; vertical-stretch: 1;
                if root.has-preview && !root.video : Image {
                    x: 24px; y: 24px; width: parent.width - 48px; height: parent.height - 48px;
                    source: root.preview; image-fit: contain;
                }
                if root.video : clip := FocusScope {
                    x: 24px; y: 24px; width: parent.width - 48px; height: parent.height - 48px;
                    accessible-role: groupbox;
                    accessible-label: "Video preview";
                    key-pressed(event) => {
                        if (event.text == Key.Space) { root.action("play"); return accept; }
                        if (event.text == Key.LeftArrow) { root.action("back"); return accept; }
                        if (event.text == Key.RightArrow) { root.action("forward"); return accept; }
                        reject
                    }
                    // Skeleton until the first frame is decoded
                    Rectangle {
                        x: 0px; y: 0px; width: parent.width; height: parent.height - 56px;
                        border-radius: Theme.radius;
                        background: root.has-preview ? transparent : Theme.chrome;
                        if root.has-preview : Image {
                            width: parent.width; height: parent.height;
                            source: root.preview; image-fit: contain;
                        }
                        TouchArea { clicked => { clip.focus(); root.action("play"); } }
                    }
                    Transport {
                        x: 0px; y: parent.height - 36px; width: parent.width;
                        track: true;
                        playing: root.playing; clock: root.clock; position: root.position; volume: root.volume;
                        action(name) => { root.action(name); }
                        seek(fraction) => { root.seek(fraction); }
                        volume-changed(value) => { root.volume-changed(value); }
                    }
                }
                if root.audio : player := FocusScope {
                    x: 32px; width: parent.width - 64px;
                    height: 236px; y: (parent.height - self.height) / 2;
                    accessible-role: groupbox;
                    accessible-label: "Audio preview";
                    key-pressed(event) => {
                        if (event.text == Key.Space) { root.action("play"); return accept; }
                        if (event.text == Key.LeftArrow) { root.action("back"); return accept; }
                        if (event.text == Key.RightArrow) { root.action("forward"); return accept; }
                        reject
                    }
                    // While the pointer holds the waveform, the head follows it; the seek happens on release
                    property <bool> scrubbing: false;
                    property <float> scrub: 0;
                    property <float> shown: self.scrubbing ? self.scrub : root.position;
                    VerticalLayout {
                        spacing: 0px;
                        Text { text: root.title; color: Theme.text; font-size: Theme.font-heading; font-weight: 600; overflow: elide; }
                        Rectangle { height: 6px; }
                        Text { text: root.summary; color: Theme.subtle; font-size: Theme.font-caption; overflow: elide; }
                        Rectangle { height: 18px; }
                        wave := Rectangle {
                            height: 128px;
                            accessible-role: slider;
                            accessible-label: "Position";
                            accessible-value: root.clock;
                            // Skeleton until the summary arrives: the centre line alone
                            Rectangle { y: (parent.height - 1px) / 2; height: 1px; width: parent.width; background: Theme.line-strong; }
                            if root.wave != "" : Path {
                                x: 0px; width: parent.width; height: parent.height;
                                commands: root.wave; viewbox-width: root.wave-bins; viewbox-height: 2; fit: fill;
                                fill: Theme.line-hover;
                            }
                            // The part already heard: the same path in the accent, clipped at the head
                            Rectangle {
                                x: 0px; width: parent.width * player.shown; height: parent.height; clip: true;
                                if root.wave != "" : Path {
                                    x: 0px; width: wave.width; height: parent.height;
                                    commands: root.wave; viewbox-width: root.wave-bins; viewbox-height: 2; fit: fill;
                                    fill: Theme.accent;
                                }
                            }
                            Rectangle {
                                x: (parent.width - 2px) * player.shown; width: 2px; height: parent.height;
                                border-radius: 1px; background: Theme.text;
                                opacity: root.playing || player.shown > 0 || player.scrubbing ? 1 : 0;
                            }
                            scrub-touch := TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                        player.focus();
                                        player.scrubbing = true;
                                        player.scrub = clamp(self.mouse-x / self.width, 0, 1);
                                    }
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && player.scrubbing) {
                                        player.scrubbing = false;
                                        root.seek(player.scrub);
                                    }
                                    if (event.kind == PointerEventKind.cancel) { player.scrubbing = false; }
                                }
                                moved => {
                                    if (player.scrubbing) { player.scrub = clamp(self.mouse-x / self.width, 0, 1); }
                                }
                            }
                        }
                        Rectangle { height: 18px; }
                        Transport {
                            playing: root.playing; clock: root.clock; position: root.position; volume: root.volume;
                            action(name) => { player.focus(); root.action(name); }
                            seek(fraction) => { root.seek(fraction); }
                            volume-changed(value) => { root.volume-changed(value); }
                        }
                    }
                }
                if !root.has-preview && !root.audio && !root.video : VerticalLayout {
                    padding: 24px; spacing: 16px; alignment: center;
                    Rectangle {
                        height: 56px;
                        ToolIcon { x: (parent.width - self.width) / 2; size: 40px; name: root.items.length == 0 ? "upload" : "convert"; tint: Theme.muted; }
                    }
                    Text { text: root.items.length == 0 ? "Drop media here" : root.title; color: Theme.text; font-size: Theme.font-heading; horizontal-alignment: center; overflow: elide; }
                    Text { text: root.items.length == 0 ? "Images, audio and video. Processed locally." : root.summary; color: Theme.subtle; wrap: word-wrap; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center; spacing: 8px;
                        AppButton { text: root.items.length == 0 ? "Browse files" : "Add files"; enabled: !root.busy; clicked => { root.action("add"); } }
                        AppButton { text: "Add folder"; quiet: true; enabled: !root.busy; clicked => { root.action("folder"); } }
                    }
                }
                DropArea {
                    can-drop(event) => { root.busy ? DragAction.none : DragAction.copy }
                    dropped(event) => { root.file-dropped(event.data); event.proposed-action }
                }
            }
            if root.message != "" : Rectangle {
                height: 56px; background: Theme.chrome;
                Text { x: 12px; y: 6px; width: parent.width - 24px; height: 44px; text: root.message; color: Theme.muted; wrap: word-wrap; overflow: elide; }
            }
            if root.progress-label != "" : Rectangle {
                height: 28px; background: Theme.chrome;
                Text { x: 12px; width: parent.width - 24px; height: 24px; text: root.progress-label; color: Theme.muted; font-size: Theme.font-caption; vertical-alignment: center; overflow: elide; }
                Rectangle { x: 0px; y: parent.height - 3px; width: parent.width * root.progress; height: 3px; background: Theme.accent; }
            }
            Rectangle {
                // Same height and top line as the Output panel's footer, so the two read as one band
                height: 64px; background: Theme.chrome;
                Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; spacing: 8px;
                    Text { text: root.busy ? "Working…" : root.has-preview || root.audio || root.video ? root.summary : root.items.length == 0 ? "No file selected" : root.items.length + " file(s)"; color: Theme.subtle; vertical-alignment: center; overflow: elide; }
                    Rectangle { horizontal-stretch: 1; }
                    if root.completed : VerticalLayout {
                        alignment: center;
                        AppButton { text: "Show in folder"; quiet: true; small: true; clicked => { root.action("reveal"); } }
                    }
                }
            }
        }
    }

    if root.inspector-open : Rectangle {
        accessible-role: groupbox;
        accessible-label: "Converter output";
        x: parent.width - root.inspector-width;
        y: 0px;
        width: root.inspector-width;
        height: parent.height;
        background: Theme.chrome;
        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: Theme.line; }
        VerticalLayout {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            spacing: 0px;
            Rectangle {
                height: 36px;
                Text { x: 16px; height: parent.height; text: "Output"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
            }
            if root.needs-ffmpeg : Rectangle {
                height: 104px;
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    Text { text: "Audio and video need FFmpeg"; color: Theme.muted; wrap: word-wrap; }
                    AppButton { text: "Install FFmpeg"; small: true; enabled: !root.busy; clicked => { root.action("install"); } }
                    Text { text: "Downloaded only when you choose to install."; color: Theme.subtle; font-size: Theme.font-caption; wrap: word-wrap; }
                }
            }
            Rectangle {
                height: 32px;
                Text { x: 16px; height: parent.height; text: "Convert to"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
            }
            ListView {
                for format in root.formats : FocusScope {
                    property <length> body: format.note != "" ? 80px : 64px;
                    height: format.header ? self.body + 24px : self.body;
                    focus-on-tab-navigation: true;
                    accessible-role: button;
                    accessible-label: "Convert to " + format.name;
                    accessible-action-default => { if (!root.busy) { root.target(format.id); } }
                    key-pressed(event) => {
                        if (!root.busy && (event.text == Key.Return || event.text == Key.Space)) { root.target(format.id); accept } else { reject }
                    }
                    // Video's audio-only outputs start under their own caption
                    if format.header : Rectangle {
                        y: 0px; height: 24px;
                        Rectangle { y: 0px; height: 1px; width: parent.width; background: Theme.line; }
                        Text { x: 16px; y: 8px; text: "Audio only"; color: Theme.subtle; font-size: Theme.font-label; font-weight: 600; }
                    }
                    Rectangle {
                        y: format.header ? 24px : 0px; height: parent.body;
                        background: format.selected ? Theme.control-active : format-touch.has-hover ? Theme.control-hover : transparent;
                        VerticalLayout {
                            padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px; spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: (format.selected ? "●  " : "○  ") + format.name; color: Theme.text; font-weight: 500; }
                                if format.recommended : Rectangle {
                                    width: badge.preferred-width + 12px; height: 16px;
                                    border-radius: 8px; border-width: 1px; border-color: Theme.accent.transparentize(50%);
                                    badge := Text { text: "Recommended"; color: Theme.accent; font-size: Theme.font-label; vertical-alignment: center; horizontal-alignment: center; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text { text: format.detail; color: Theme.subtle; font-size: Theme.font-caption; overflow: elide; }
                            // What this output costs or changes (copy, re-encode, transparency, subtitles…)
                            if format.note != "" : Text { text: format.note; color: format.selected ? Theme.muted : Theme.subtle; font-size: Theme.font-caption; overflow: elide; }
                        }
                        format-touch := TouchArea { enabled: !root.busy; clicked => { root.target(format.id); } }
                    }
                }
            }
            Rectangle {
                height: 64px;
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
                VerticalLayout {
                    padding-left: 16px; padding-right: 16px; padding-top: 12px; padding-bottom: 10px; spacing: 3px;
                    alignment: start;
                    Text { text: "Save location"; color: Theme.muted; font-weight: 600; }
                    Text { text: root.completed ? root.output : "Uses Settings → Files. Originals are never modified."; color: Theme.subtle; wrap: word-wrap; overflow: elide; font-size: Theme.font-caption; }
                }
            }
        }
    }
}
