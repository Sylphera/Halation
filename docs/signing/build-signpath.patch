+
+      - name: Upload unsigned executable
+        if: env.SIGNPATH == 'true'
+        id: unsigned-exe
+        uses: actions/upload-artifact@v6
+        with:
+          name: unsigned-exe
+          path: app/src-tauri/target/release/halation.exe
