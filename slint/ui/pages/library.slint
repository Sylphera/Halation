import { Theme } from "../theme.slint";
import { ToolIcon } from "../icons.slint";
import { AppButton } from "../components/button.slint";
import { PageHeader } from "../components/page-header.slint";
import { StatusChip } from "../components/status-chip.slint";
import { Notice } from "../components/notice.slint";
import { LibraryRow, SectionRow, ItemRow } from "../models.slint";
import { SectionsView } from "sections.slint";
import { ListView } from "std-widgets.slint";

export component LibraryPage inherits Rectangle {
    in property <[LibraryRow]> rows;
    in property <string> query: "";
    in property <int> total: 0;
    in property <int> missing: 0;
    in property <bool> loaded: false;
    in property <bool> busy: false;
    in property <bool> writable: false;
    in property <string> error: "";
    in property <string> notice: "";
    in property <duration> motion-duration: 160ms;
    in property <[SectionRow]> sections;
    in property <[ItemRow]> section-items;
    in property <string> section-name: "";
    in property <string> section-kind: "";
    in property <string> section-id: "";
    in property <int> section-hidden: 0;
    in property <bool> sections-loaded: false;
    in property <bool> sections-busy: false;
    // Presentation only: 0 = references, 1 = sections
    in-out property <int> mode: 0;

    callback choose-reference();
    callback select-section(string);
    callback create-section(string);
    callback rename-section(string, string);
    callback delete-section(string);
    callback link-folder();
    callback unlink-folder(string);
    callback sections-opened();
    callback remove-reference(string);
    callback set-query(string);
    callback open-settings();
    callback dismiss-notice();

    background: transparent;

    VerticalLayout {
        padding-left: Theme.side-padding(root.width);
        padding-right: Theme.side-padding(root.width);
        padding-top: Theme.top-padding(root.height);
        padding-bottom: 20px;
        spacing: 16px;

        PageHeader {
            title: "Library";
            subtitle: "References, not copies. Adding or removing an entry never moves or deletes the original file.";
            if root.busy : StatusChip {
                text: "Saving";
                tone: "accent";
            }
            if root.mode == 0 : AppButton {
                text: "Add reference";
                primary: true;
                enabled: root.loaded && root.writable && !root.busy;
                motion-duration: root.motion-duration;
                clicked => { root.choose-reference(); }
            }
        }

        HorizontalLayout {
            height: 36px;
            spacing: 12px;

            // Segmented switch between the two views of the Library
            Rectangle {
                width: 2 * 116px + 8px;
                border-radius: Theme.radius-control;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding: 3px;
                    spacing: 2px;
                    for label[index] in ["References", "Sections"] : Rectangle {
                        width: 116px;
                        border-radius: Theme.radius-chip;
                        background: root.mode == index ? Theme.surface-high : (tab-touch.has-hover ? Theme.surface-raised : transparent);
                        accessible-role: tab;
                        accessible-label: label;
                        accessible-item-selected: root.mode == index;
                        accessible-action-default => {
                            root.mode = index;
                            if (index == 1) { root.sections-opened(); }
                        }
                        animate background { duration: root.motion-duration; easing: ease-out; }
                        Text {
                            text: label;
                            color: root.mode == index ? Theme.text : Theme.muted;
                            font-size: Theme.font-label;
                            font-weight: root.mode == index ? 600 : 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.mode = index;
                                if (index == 1) { root.sections-opened(); }
                            }
                        }
                    }
                }
            }

            if root.mode == 0 && root.total > 0 : Text {
                text: root.total + (root.total == 1 ? " reference" : " references");
                color: Theme.subtle;
                font-size: Theme.font-label;
                vertical-alignment: center;
            }
            if root.mode == 0 && root.missing > 0 : VerticalLayout {
                alignment: center;
                StatusChip {
                    text: root.missing + " missing";
                    tone: "danger";
                }
            }
            Rectangle { horizontal-stretch: 1; }

            if root.mode == 0 : Rectangle {
                width: min(320px, max(200px, parent.width * 0.38));
                border-radius: Theme.radius-control;
                background: Theme.surface;
                border-width: input.has-focus ? 2px : 1px;
                border-color: input.has-focus ? Theme.accent : Theme.border;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        ToolIcon { name: "search"; tint: Theme.subtle; }
                    }
                    input := TextInput {
                        single-line: true;
                        text: root.query;
                        color: Theme.text;
                        font-size: Theme.font-label;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        accessible-role: text-input;
                        accessible-label: "Filter references";
                        edited => { root.set-query(input.text); }
                    }
                }
                if root.query == "" : Text {
                    text: "Filter by name or path";
                    color: Theme.subtle;
                    font-size: Theme.font-label;
                    x: 36px;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        if root.error != "" : Notice {
            text: root.error;
            error: true;
        }

        if root.notice != "" : Notice {
            text: root.notice;
            dismiss => { root.dismiss-notice(); }
        }

        if root.mode == 0 && !root.loaded : Rectangle {
            vertical-stretch: 1;
            background: transparent;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: "Loading references…";
                    color: Theme.muted;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                }
            }
        }

        if root.mode == 0 && root.loaded && root.rows.length == 0 : Rectangle {
            vertical-stretch: 1;
            background: transparent;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                ToolIcon { name: "library"; tint: Theme.muted; }
                Text {
                    text: root.total == 0 ? "No references yet" : "No matches";
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.total == 0
                        ? "Add a song or an image with “Add reference”, or drop one on Home."
                        : "Try a different name or path.";
                    color: Theme.muted;
                    font-size: Theme.font-label;
                    horizontal-alignment: center;
                }
            }
        }

        if root.mode == 0 && root.loaded && root.rows.length > 0 : Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-panel;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            ListView {
                width: parent.width;
                height: parent.height;
                for row in root.rows : Rectangle {
                    height: 66px;
                    width: parent.width;
                    background: row-hover.has-hover ? Theme.surface-raised : transparent;

                    Rectangle {
                        y: parent.height - 1px;
                        x: 12px;
                        width: parent.width - 24px;
                        height: 1px;
                        background: Theme.border;
                    }
                    row-hover := TouchArea { }

                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: Theme.radius-control;
                            background: Theme.surface-high;
                            ToolIcon {
                                name: "library";
                                tint: Theme.muted;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: row.name;
                                color: Theme.text;
                                font-size: Theme.font-body;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: row.path;
                                color: Theme.subtle;
                                font-size: Theme.font-caption;
                                overflow: elide;
                            }
                        }
                        if row.missing : VerticalLayout {
                            alignment: center;
                            StatusChip {
                                text: "Missing";
                                tone: "danger";
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            AppButton {
                                text: "Remove";
                                compact: true;
                                enabled: root.writable && !root.busy;
                                clicked => { root.remove-reference(row.id); }
                            }
                        }
                    }
                }
            }
        }

        if root.mode == 1 : SectionsView {
            vertical-stretch: 1;
            sections: root.sections;
            items: root.section-items;
            selected-id: root.section-id;
            selected-name: root.section-name;
            selected-kind: root.section-kind;
            hidden: root.section-hidden;
            loaded: root.sections-loaded;
            busy: root.sections-busy;
            motion-duration: root.motion-duration;
            select-section(id) => { root.select-section(id); }
            create-section(name) => { root.create-section(name); }
            rename-section(id, name) => { root.rename-section(id, name); }
            delete-section(id) => { root.delete-section(id); }
            link-folder => { root.link-folder(); }
            unlink-folder(id) => { root.unlink-folder(id); }
        }

    }
}
