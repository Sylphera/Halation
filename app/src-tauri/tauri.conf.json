{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halation",
  "version": "1.1.1",
  "identifier": "com.halation.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Halation",
        "width": 1480,
        "height": 940,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0f0e0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Sylphera",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/halation-mark.ico": "halation-mark.ico",
      "../../LICENSE": "LICENSE.txt",
      "../../NOTICE.md": "NOTICE.md",
      "../../THIRD_PARTY.md": "THIRD_PARTY.md",
      "windows/identity-out/Halation.msix": "Halation.msix",
      "windows/identity/Assets/StoreLogo.png": "Assets/StoreLogo.png",
      "windows/identity/Assets/Square44x44Logo.png": "Assets/Square44x44Logo.png",
      "windows/identity/Assets/Square150x150Logo.png": "Assets/Square150x150Logo.png"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish"
        ],
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "template": "./windows/installer.nsi"
      }
    },
    "copyright": "Copyright (c) 2026 Sylphera. GPL-3.0-or-later.",
    "shortDescription": "High-quality local multimedia workspace"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2QzA3OEU2REI2MTY2NzAKUldSd1ptSGI1bmpBUnRlbzVaNFZlL3pMdFpKcWI5YmNtWnZRN2lhVFUwNWpkUjJEYlRBbHh5STIK",
      "endpoints": [
        "https://github.com/Sylphera/Halation/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
