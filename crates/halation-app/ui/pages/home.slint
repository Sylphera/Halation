import { Theme } from "../theme.slint";
import { Assets } from "../assets.slint";
import { ToolIcon } from "../icons.slint";
import { ToolItem, RecentItem } from "../models.slint";
import { Motion, Curve } from "../motion.slint";
import { PillList } from "../components/pills.slint";

// One entry of Home's tool strip: icon over its name. Its hover is the strip's sliding pill: it reports where it is.
component StripItem inherits FocusScope {
    in property <string> icon;
    in property <string> label;
    callback activated;
    callback hovered(bool, length, length);
    changed x => {
        if (touch.has-hover) {
            root.hovered(true, root.absolute-position.x, root.width);
        }
    }
    // Shrinks towards the label's width when the window is narrow
    preferred-width: name.preferred-width + 20px;
    min-width: name.preferred-width + 4px;
    height: 52px;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { activated(); }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == Key.Space) {
            activated();
            accept
        } else {
            reject
        }
    }
    Rectangle {
        border-radius: Theme.radius;
        background: touch.pressed ? Theme.press-fill : transparent;
        border-width: root.has-focus ? 2px : 0px;
        border-color: Theme.accent;
    }
    Rectangle {
        // Sinks at once on press, back on release
        // Both axes set explicitly: animating them with only the `transform-scale` shorthand set leaves them at 0 (Slint 1.18)
        transform-scale-x: touch.pressed ? Motion.press-scale : 100%;
        transform-scale-y: self.transform-scale-x;
        animate transform-scale-x, transform-scale-y { duration: touch.pressed ? 0ms : Motion.release; easing: Curve.ease; }
        ToolIcon {
            x: (parent.width - self.width) / 2;
            y: 9px;
            name: root.icon;
            size: 17px;
            tint: touch.has-hover ? Theme.text : Theme.muted;
            animate tint { duration: Motion.hover(touch.has-hover); easing: Curve.ease; }
        }
        name := Text {
            x: (parent.width - self.width) / 2;
            y: 31px;
            text: root.label;
            color: touch.has-hover ? Theme.text : Theme.muted;
            animate color { duration: Motion.hover(touch.has-hover); easing: Curve.ease; }
            font-size: Theme.font-caption;
            font-weight: 500;
            accessible-role: none;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.focus();
            root.activated();
        }
        changed has-hover => {
            root.hovered(self.has-hover, root.absolute-position.x, root.width);
        }
    }
}

// Home as in the original (Java, 2026-10-22: back to it, inside the curved frame): the mark and wordmark, the
// tagline, the strip of tools, and the drop zone with recent files anchored to the bottom. Surfaces and corners use
// the frame's tokens: the panel fill, a faint line and the one radius.
export component HomePage inherits Rectangle {
    in property <[ToolItem]> tools;
    in property <[RecentItem]> recent;
    in property <bool> library-loaded: false;

    callback tool-activated(string);
    callback choose-reference();
    callback file-dropped(data-transfer);

    // The hero's top edge follows the window's middle; the drop zone keeps 70 px to the bottom
    property <length> hero-top: max(24px, root.height / 2 - 259px);
    property <length> drop-top: max(root.hero-top + 286px, root.height - 70px - 55px - 15px - 150px);

    Image {
        x: (parent.width - self.width) / 2;
        y: root.hero-top;
        width: 176px;
        height: 87px;
        source: Assets.mark;
        image-fit: contain;
        accessible-role: image;
        accessible-label: "Halation";
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: root.hero-top + 113px;
        width: 241px;
        height: 26px;
        source: Assets.wordmark;
        colorize: Theme.text;
        image-fit: contain;
    }

    Text {
        x: (parent.width - self.width) / 2;
        y: root.hero-top + 153px;
        text: "Take your time. Everything else is instant.";
        color: Theme.muted;
        font-size: Theme.font-title;
    }

    // Tool strip
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.hero-top + 202px;
        width: min(strip.preferred-width, parent.width - 24px);
        height: 62px;
        border-radius: Theme.radius;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line;
        // The hover pill, gliding along the strip behind the tools
        strip-pills := PillList {
            x: 5px;
            y: 5px;
            width: parent.width - 10px;
            height: parent.height - 10px;
            horizontal: true;
            has-selection: false;
            hover-fill: Theme.hover-fill;
            radius: Theme.radius;
        }
        strip := HorizontalLayout {
            padding-left: 5px;
            padding-right: 5px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 0px;
            for tool in root.tools : StripItem {
                icon: tool.icon;
                label: tool.name;
                activated => { root.tool-activated(tool.id); }
                hovered(on, at, size) => { strip-pills.hover(on, at, size); }
            }
        }
    }

    // Drop zone
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.drop-top;
        width: min(640px, parent.width - 48px);
        height: 150px;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: drop-area.has-drag || drop-focus.has-focus ? Theme.accent : Theme.line-strong;
        background: drop-area.has-drag ? #1d1e27e6 : (drop-touch.has-hover ? #19191be0 : Theme.panel);
        animate background, border-color { duration: Motion.hover(drop-touch.has-hover || drop-area.has-drag); easing: Curve.ease; }
        // Grows a little under a dragged file, sinks a little on press
        // (nothing scales with reduced motion, when the press scale is 100 %)
        // Both axes set explicitly: animating them with only the `transform-scale` shorthand set leaves them at 0 (Slint 1.18)
        transform-scale-x: Motion.press-scale >= 100% ? 100% : drop-touch.pressed ? 99% : drop-area.has-drag ? 101% : 100%;
        transform-scale-y: self.transform-scale-x;
        animate transform-scale-x, transform-scale-y { duration: drop-touch.pressed ? 0ms : Motion.glide; easing: spring(0); }


        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 23px;
            width: 48px;
            height: 48px;
            border-radius: Theme.radius;
            background: Theme.control;
            border-width: 1px;
            border-color: Theme.line-strong;
            ToolIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: "upload";
                size: 22px;
                tint: Theme.text;
            }
        }

        Text {
            x: (parent.width - self.width) / 2;
            y: 83px;
            text: drop-area.has-drag ? "Drop to add it to your Library" : "Drop a song or an image";
            color: Theme.text;
            font-size: 15.5px;
            font-weight: 600;
        }
        Text {
            x: (parent.width - self.width) / 2;
            y: 108px;
            text: "Or click to browse. Files are added to your Library, never copied.";
            color: Theme.subtle;
            font-size: Theme.font-body;
        }

        drop-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                drop-focus.focus();
                root.choose-reference();
            }
        }
        drop-focus := FocusScope {
            width: 0px;
            height: 0px;
            focus-on-tab-navigation: true;
            accessible-role: button;
            accessible-label: "Drop a song or an image, or click to browse";
            accessible-action-default => { root.choose-reference(); }
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == Key.Space) {
                    root.choose-reference();
                    accept
                } else {
                    reject
                }
            }
        }
        drop-area := DropArea {
            can-drop(event) => { DragAction.copy }
            dropped(event) => {
                root.file-dropped(event.data);
                event.proposed-action
            }
        }
    }

    // Recent files
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.drop-top + 165px;
        width: min(593px, parent.width - 48px);
        height: 55px;
        border-radius: Theme.radius;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line;
        Text {
            x: 21px;
            y: (parent.height - self.height) / 2;
            text: "RECENT FILES";
            color: Theme.subtle;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.32px;
        }
        if root.recent.length == 0 : Text {
            x: 130px;
            y: (parent.height - self.height) / 2;
            width: parent.width - 150px;
            text: root.library-loaded ? "Files you add to the Library show up here." : "Reading your Library…";
            color: Theme.subtle;
            font-size: Theme.font-small;
            overflow: elide;
        }
        if root.recent.length > 0 : HorizontalLayout {
            x: 130px;
            width: parent.width - 150px;
            spacing: 16px;
            for item in root.recent : Text {
                text: item.name;
                color: Theme.muted;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
                max-width: 150px;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}
