import { Theme } from "../theme.slint";
import { Motion, Curve } from "../motion.slint";

// The hover and selection pills of a list of rows: two rectangles without children that stretch to the row the rows
// report and close up on it. Draw it behind the rows, in the same parent; it covers the parent's width less `inset-left`
// and `inset-right`. Positions come in window coordinates.
export component PillList inherits Rectangle {
    in property <length> inset-left: 8px;
    in property <length> inset-right: 9px;
    // Horizontal lists (Home's strip): the pills glide in x and take the reported width
    in property <bool> horizontal: false;
    in property <color> hover-fill: Theme.control-hover;
    in property <color> select-fill: Theme.control-active;
    in property <length> radius: Theme.radius-control;
    // False while no row of the list stands for what is shown
    in property <bool> has-selection: true;
    // An accent bar beside the selected row (the sidebar)
    in property <bool> bar: false;

    property <length> hover-at;
    property <length> hover-size;
    property <bool> hover-on: false;
    property <bool> hover-snap: true;
    // Which way the pill last moved: down or right is forward
    property <bool> hover-forward: true;
    // The pill is gone (no row hovered for a moment): the next hover places it at once instead of gliding
    property <bool> hover-idle: true;
    // When the pointer last entered a row, and the glide of the pill's leading edge now (its trailing edge takes twice)
    property <duration> hover-tick;
    property <duration> hover-lead: Motion.glide;
    property <length> select-at;
    property <length> select-size;
    property <bool> select-on: false;
    property <bool> select-snap: true;
    property <bool> select-forward: true;
    property <length> origin: root.horizontal ? root.absolute-position.x : root.absolute-position.y;

    public function hover(on: bool, at: length, size: length) {
        if (on) {
            // Appearing, it starts at the row; moving between rows (or across a gap between them), it glides
            // While the pointer sweeps the list, the glide follows its pace: about the time it takes to cross a row,
            // so the pill is still on its way when the next row turns it, and never stops at each row. Faster sweeps
            // give a faster pill (down to 65 % of `glide`), slower ones a slower one (up to three times); from rest,
            // or after a pause of over 250 ms, it is `glide`. Averaged with the last crossing so an uneven hand does
            // not jolt it. One sum per row crossed; no frame is added.
            root.hover-lead = Motion.glide <= 0ms ? 0ms
                : root.hover-idle || animation-tick() - root.hover-tick > 250ms ? Motion.glide
                : (root.hover-lead + max(Motion.glide * 0.65, min(Motion.glide * 3, (animation-tick() - root.hover-tick) * 0.8))) / 2;
            root.hover-tick = animation-tick();
            root.hover-snap = root.hover-idle;
            root.hover-idle = false;
            leave.running = false;
            root.hover-forward = at - root.origin >= root.hover-at;
            root.hover-at = at - root.origin;
            root.hover-size = size;
            root.hover-on = true;
        } else if (root.hover-at == at - root.origin) {
            root.hover-on = false;
            leave.running = true;
        }
    }
    public function select(at: length, size: length, snap: bool) {
        root.select-snap = snap || !root.select-on;
        root.select-forward = at - root.origin >= root.select-at;
        root.select-at = at - root.origin;
        root.select-size = size;
        root.select-on = true;
    }

    leave := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.running = false;
            if (!root.hover-on) {
                root.hover-idle = true;
            }
        }
    }

    // Each pill is drawn between two edges along the list. Moving, the edge in front leads (`glide`) and the edge
    // behind follows (`trail`): the pill stretches towards the new row and closes up on it, one shape all the way.
    // A spring, not an ease curve: a sweep retargets the pill at every row, and a spring keeps its speed across a
    // retarget where an ease curve restarts from standstill (the pill stopped and started at each row)
    property <length> select-start: root.select-at;
    property <length> select-end: root.select-at + root.select-size;
    animate select-start { duration: root.select-snap ? 0ms : root.select-forward ? Motion.trail : Motion.glide; easing: spring(0); }
    animate select-end { duration: root.select-snap ? 0ms : root.select-forward ? Motion.glide : Motion.trail; easing: spring(0); }
    property <length> hover-start: root.hover-at;
    property <length> hover-end: root.hover-at + root.hover-size;
    animate hover-start { duration: root.hover-snap ? 0ms : root.hover-forward ? root.hover-lead * 2 : root.hover-lead; easing: spring(0); }
    animate hover-end { duration: root.hover-snap ? 0ms : root.hover-forward ? root.hover-lead : root.hover-lead * 2; easing: spring(0); }

    selection := Rectangle {
        x: root.horizontal ? root.select-start : root.inset-left;
        y: root.horizontal ? 0px : root.select-start;
        width: root.horizontal ? max(0px, root.select-end - root.select-start) : parent.width - root.inset-left - root.inset-right;
        height: root.horizontal ? parent.height : max(0px, root.select-end - root.select-start);
        border-radius: root.radius;
        background: root.select-on && root.has-selection ? root.select-fill : root.select-fill.transparentize(1);
    }
    // The accent bar beside the selected row (vertical lists with `bar`), stretching with the pill
    if root.bar && !root.horizontal : Rectangle {
        x: max(0px, root.inset-left - 6px);
        y: root.select-start + root.select-size * 0.3;
        width: 3px;
        height: max(0px, root.select-end - root.select-start - root.select-size * 0.6);
        border-radius: 1.5px;
        background: root.select-on && root.has-selection ? Theme.accent : Theme.accent.transparentize(1);
    }
    hover-pill := Rectangle {
        x: root.horizontal ? root.hover-start : root.inset-left;
        y: root.horizontal ? 0px : root.hover-start;
        width: root.horizontal ? max(0px, root.hover-end - root.hover-start) : parent.width - root.inset-left - root.inset-right;
        height: root.horizontal ? parent.height : max(0px, root.hover-end - root.hover-start);
        border-radius: root.radius;
        background: root.hover-on ? root.hover-fill : root.hover-fill.transparentize(1);
        animate background { duration: Motion.hover(root.hover-on); easing: Curve.ease; }
    }
}
