// Tokens of docs/SLINT_VISUAL_SYSTEM.md, measured on the rendered original Halation. Rust (`theme.rs`) applies the
// colour values at start-up; the defaults here match them so headless tests and snapshots render the same.
export global Theme {
    in-out property <color> ground: #070707;
    in-out property <color> ground-top: #0b0b0c;
    in-out property <color> panel: #111111;
    in-out property <color> raised: #242424;
    in-out property <color> field: #080808;
    in-out property <color> line: #3d3d39;
    in-out property <color> line-strong: #55554f;
    in-out property <color> text: #f5f5f2;
    in-out property <color> muted: #b5b5af;
    in-out property <color> subtle: #9a9993;
    in-out property <color> accent: #a3a8dc;
    in-out property <color> activity: #82b5d6;
    in-out property <color> warning: #e0b15e;
    in-out property <color> beta: #e391a4;
    in-out property <color> danger: #f0a6a6;
    in-out property <color> success: #9fd6b2;

    // Translucent layers over the backdrop (the original blurs behind them; here they are flat)
    out property <color> glass: #111111ad;
    out property <color> hairline: #fffffa1c;
    out property <color> sheen: #fffffa1f;

    out property <length> radius-panel: 20px;
    out property <length> radius-field: 10px;
    out property <length> radius-icon: 12px;

    out property <length> font-title: 13.5px;
    out property <length> font-body: 12.5px;
    out property <length> font-small: 12px;
    out property <length> font-tiny: 10.5px;
}
