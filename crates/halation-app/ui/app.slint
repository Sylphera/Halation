import { Palette } from "std-widgets.slint";
import { Assets } from "assets.slint";
import { Theme } from "theme.slint";
import { ToolItem, LibraryRow, JobRow, RecentItem, SectionRow, ItemRow, Prefs, ComponentRow, FolderRow } from "models.slint";
export { Theme } from "theme.slint";
export { Assets } from "assets.slint";
export { Motion } from "motion.slint";
import { Motion, Curve } from "motion.slint";
export { ToolItem, LibraryRow, JobRow, RecentItem, SectionRow, ItemRow, Prefs, ComponentRow, FolderRow } from "models.slint";
import { HomePage } from "pages/home.slint";
import { SettingsPage } from "pages/settings.slint";
import { ConverterPage } from "pages/converter.slint";
import { ConvertRow, FormatRow } from "models.slint";
export { ConvertRow, FormatRow } from "models.slint";
import { FrameCapturePage } from "pages/framegrab.slint";
import { FrameQueueRow, FrameLayoutRow, FrameDestinationRow, FrameResultRow, FrameStrings } from "models.slint";
export { FrameQueueRow, FrameLayoutRow, FrameDestinationRow, FrameResultRow, FrameStrings } from "models.slint";
import { AppButton } from "components/button.slint";
import { SidebarItem, SidebarGroup, PillList } from "components/rail-item.slint";
import { ShellStrings } from "models.slint";
export { ShellStrings } from "models.slint";
import { BarButton } from "components/top-dock.slint";

export component AppWindow inherits Window {
    title: "Halation";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.chrome;
    icon: Assets.app-icon;
    default-font-family: Theme.ui-face;
    default-font-size: Theme.font-body;

    init => {
        Palette.color-scheme = ColorScheme.dark;
        keys.focus();
    }

    // Pages: 0 Home, 3 Settings (Java, 2026-10-22: the Workspace and the Library are gone for now; 1 and 2 are unused)
    in property <int> page: 0;
    in property <string> settings-label;
    in property <ShellStrings> shell-strings;
    in property <bool> reduced-motion: false;
    in property <int> diagnostic-scene: 1;
    in property <string> build-label: "";
    in property <string> profile-path: "";
    in property <string> library-query: "";
    // Home's backdrop: the frame of the Drape loop on screen (Rust's player sets it 15 times a second)
    in property <image> backdrop;
    in property <[ToolItem]> tools;
    in property <[ToolItem]> active-tools;
    in property <[LibraryRow]> library-rows;
    in property <[JobRow]> jobs;
    in property <[RecentItem]> recent;
    in property <int> library-total: 0;
    in property <int> library-missing: 0;
    in property <bool> library-busy: false;
    in property <bool> library-writable: false;
    in property <bool> library-loaded: false;
    in property <string> library-error: "";
    in property <int> library-limit: 2000;
    in property <bool> settings-writable: true;
    in property <string> settings-error: "";
    in property <Prefs> prefs;
    in property <string> notice: "";
    in property <string> jobs-capability: "";
    in property <bool> jobs-has-finished: false;
    in property <bool> jobs-busy: false;
    in property <string> storage-used: "";
    in property <string> app-size: "";
    in property <string> workspace-size: "";
    in property <[ComponentRow]> components;
    in property <[FolderRow]> folders;
    in property <[SectionRow]> sections;
    in property <[ItemRow]> section-items;
    in property <string> section-id: "";
    in property <string> section-name: "";
    in property <string> section-kind: "";
    in property <int> section-hidden: 0;
    in property <bool> sections-loaded: false;
    in property <bool> sections-busy: false;
    // Library tab: 0 references, 1 sections (in-out so a headless snapshot can fix it)
    in-out property <int> library-mode: 0;
    // The sidebar open with labels; closed it shows icons only (planning/active/ui-redesign.md §6)
    in-out property <bool> rail-open: false;
    // Settings category to open at (headless snapshots)
    in property <int> settings-jump: -1;
    // Settings category shown (the top bar's search changes it)
    in-out property <int> settings-category: 0;
    in property <[ConvertRow]> convert-rows;
    in property <[FormatRow]> convert-formats;
    in property <string> convert-title;
    in property <string> convert-summary;
    in property <string> convert-message;
    in property <string> convert-output;
    in property <image> convert-preview;
    in property <bool> convert-has-preview: false;
    in property <bool> convert-busy: false;
    in property <bool> convert-can-run: false;
    in property <bool> convert-needs-ffmpeg: true;
    in property <bool> convert-completed: false;
    in property <bool> convert-left-open: false;
    in property <bool> convert-inspector-open: true;
    in property <float> convert-progress: 0;
    in property <string> convert-progress-label;
    in property <bool> convert-audio: false;
    in property <string> convert-wave;
    in property <float> convert-wave-bins: 480;
    in property <bool> convert-playing: false;
    in property <float> convert-position: 0;
    in property <string> convert-clock;
    in property <bool> convert-video: false;
    in property <float> convert-volume: 1;
    callback converter-action(string);
    callback converter-select(int);
    callback converter-target(string);
    callback converter-seek(float);
    callback converter-volume(float);
    callback converter-remove(int);
    callback converter-loaded();
    callback converter-dropped(data-transfer);
    in-out property <bool> export-choice-visible: false;
    in property <bool> ffmpeg-ready: false;
    in property <bool> ffmpeg-installing: false;

    // Frame Capture (page 5). Rust owns every decoded frame, the queue, the session and the files.
    in property <[FrameQueueRow]> frame-queue;
    in property <string> frame-queue-count-label;
    in property <string> frame-action-label;
    in property <int> frame-inspector-tab: 0;
    in property <[FrameLayoutRow]> frame-layouts;
    in property <[FrameDestinationRow]> frame-destinations;
    in property <[FrameResultRow]> frame-results;
    in property <FrameStrings> frame-strings;
    in property <image> frame-preview;
    in property <image> frame-strip;
    in property <bool> frame-has-preview: false;
    in property <bool> frame-has-strip: false;
    in property <bool> frame-has-video: false;
    in property <bool> frame-needs-ffmpeg: true;
    in property <bool> frame-installing: false;
    in property <bool> frame-busy: false;
    in property <string> frame-message;
    in property <float> frame-progress: 0;
    in property <string> frame-progress-label;
    in property <bool> frame-playing: false;
    in property <float> frame-position: 0;
    in property <float> frame-volume: 0.8;
    in property <int> frame-current: 0;
    in property <int> frame-frames: 0;
    in property <int> frame-video-width: 0;
    in property <int> frame-video-height: 0;
    in property <string> frame-frame-label;
    in property <string> frame-clock;
    in property <string> frame-sharp-note;
    in property <string> frame-selected-label;
    in property <float> frame-crop-x: 0;
    in property <float> frame-crop-y: 0;
    in property <float> frame-crop-w: 1;
    in property <float> frame-crop-h: 1;
    in property <bool> frame-crop-visible: false;
    in property <int> frame-selected-count: 0;
    in property <bool> frame-can-capture: false;
    in property <bool> frame-left-open: false;
    in property <bool> frame-inspector-open: true;
    callback frame-action(string);
    callback frame-inspector-tab-selected(int);
    callback frame-select(int);
    callback frame-toggle(int);
    callback frame-remove(int);
    callback frame-layout(string);
    callback frame-destination(string);
    callback frame-scrub(float, bool);
    callback frame-scrub-end(float);
    callback frame-crop-set(float, float);
    callback frame-crop-move(float, float);
    callback frame-volume-changed(float);
    callback frame-dropped(data-transfer);
    callback frame-reveal(int);
    // Internal async notification; the UI does not trigger it.
    callback frame-task-finished();

    callback navigate(int);
    callback choose-reference();
    callback file-dropped(data-transfer);
    callback remove-reference(string);
    callback set-query(string);
    callback set-reduced-motion(bool);
    callback set-pref(string, string);
    callback preview-accent(int);
    callback set-tool-enabled(string, bool);
    callback reset-settings();
    callback search-settings(string) -> int;
    callback tool-activated(string);
    callback dock-action(string);
    callback dismiss-notice();
    callback cancel-job(string);
    callback clear-finished-jobs();
    callback jobs-changed();
    callback sections-opened();
    callback select-section(string);
    callback create-section(string);
    callback rename-section(string, string);
    callback delete-section(string);
    callback link-folder();
    callback unlink-folder(string);
    callback sections-finished();
    // Internal async notifications; the UI does not trigger these.
    callback load-finished();
    callback save-finished();
    callback references-finished();

    // The sidebar starts collapsed and never opens by itself (Java, 2026-10-22); its toggle or Ctrl+B opens it and the
    // page moves over to make room

    // The sidebar's width; the page and the top bar start where it ends
    property <length> side: root.page == 0 ? 0px : root.rail-open ? Theme.sidebar-open : Theme.sidebar-closed;
    animate side { duration: Motion.panel; easing: Curve.ease; }
    property <length> page-x: max(Theme.sheet-inset, root.side);
    property <length> frame-page-width: root.width - root.side;
    property <bool> frame-queue-visible: root.frame-left-open && root.frame-page-width >= 620px;
    property <bool> frame-inspector-visible: root.frame-inspector-open && root.frame-page-width >= 680px
        && (!root.frame-left-open || root.frame-page-width >= 900px);

    pure function group-name(group: int) -> string {
        group == 1 ? "Get" : group == 2 ? "Audio" : group == 3 ? "Image" : group == 4 ? "Video" : ""
    }

    keys := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (root.page == 4 && event.modifiers.control && event.modifiers.alt) {
                if (event.text == "b" || event.text == "B") { root.converter-action("toggle-files"); return accept; }
                if (event.text == "i" || event.text == "I") { root.converter-action("toggle-output"); return accept; }
            }
            if (root.page == 5 && event.modifiers.control && event.modifiers.alt) {
                if (event.text == "b" || event.text == "B") { root.frame-action("toggle-queue"); return accept; }
                if (event.text == "i" || event.text == "I") { root.frame-action("toggle-inspector"); return accept; }
            }
            if (root.page != 0 && event.modifiers.control && (event.text == "b" || event.text == "B")) {
                root.rail-open = !root.rail-open;
                return accept;
            }
            reject
        }

        // Every page keeps the small frame inset, without a global header. The corners are
        // the frame's inverted curves; no lines separate it from the sidebar or the top bar.
        if root.diagnostic-scene != 0 : page-sheet := Rectangle {
            x: root.page-x;
            y: Theme.sheet-inset;
            width: parent.width - root.page-x - Theme.sheet-inset;
            height: parent.height - 2 * Theme.sheet-inset;
            border-radius: Theme.radius-sheet;
            background: Theme.canvas;
            border-width: 1px;
            border-color: Theme.sheet-edge;
            clip: true;

            // Home's backdrop: the recorded Drape and a fixed film grain, only inside its content (§8)
            if root.page == 0 : Image {
                width: parent.width;
                height: parent.height;
                source: root.backdrop;
                image-fit: cover;
                image-rendering: smooth;
            }
            if root.page == 0 : Image {
                width: parent.width;
                height: parent.height;
                source: Assets.grain;
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
                // The grain's strength, Java's choice (2026-10-21)
                opacity: 0.1;
            }

            if root.page == 0 : HomePage {
                width: parent.width;
                height: parent.height;
                tools: root.active-tools;
                settings-label: root.settings-label;
                tool-activated(id) => { root.tool-activated(id); }
                settings-requested => { root.navigate(3); }
                recent: root.recent;
                library-loaded: root.library-loaded;
                choose-reference => { root.choose-reference(); }
                file-dropped(data) => { root.file-dropped(data); }
            }

            if root.page == 4 : ConverterPage {
                width: parent.width; height: parent.height;
                can-run: root.convert-can-run;
                items: root.convert-rows; formats: root.convert-formats;
                title: root.convert-title; summary: root.convert-summary;
                message: root.convert-message; output: root.convert-output;
                preview: root.convert-preview; has-preview: root.convert-has-preview;
                busy: root.convert-busy; needs-ffmpeg: root.convert-needs-ffmpeg; completed: root.convert-completed;
                left-open: root.convert-left-open; inspector-open: root.convert-inspector-open;
                progress: root.convert-progress; progress-label: root.convert-progress-label;
                audio: root.convert-audio; wave: root.convert-wave; wave-bins: root.convert-wave-bins;
                playing: root.convert-playing; position: root.convert-position; clock: root.convert-clock;
                seek(fraction) => { root.converter-seek(fraction); }
                video: root.convert-video; volume: root.convert-volume;
                volume-changed(value) => { root.converter-volume(value); }
                remove(index) => { root.converter-remove(index); }
                action(name) => { root.converter-action(name); }
                select(index) => { root.converter-select(index); }
                target(id) => { root.converter-target(id); }
                file-dropped(data) => { root.converter-dropped(data); }
            }
            if root.page == 5 : FrameCapturePage {
                width: parent.width; height: parent.height;
                strings: root.frame-strings;
                queue: root.frame-queue; queue-count-label: root.frame-queue-count-label; action-label: root.frame-action-label;
                inspector-tab: root.frame-inspector-tab; layouts: root.frame-layouts;
                destinations: root.frame-destinations; results: root.frame-results;
                preview: root.frame-preview; strip: root.frame-strip;
                has-preview: root.frame-has-preview; has-strip: root.frame-has-strip;
                has-video: root.frame-has-video; busy: root.frame-busy;
                needs-ffmpeg: root.frame-needs-ffmpeg; installing: root.frame-installing;
                message: root.frame-message; progress: root.frame-progress;
                progress-label: root.frame-progress-label;
                playing: root.frame-playing; position: root.frame-position; volume: root.frame-volume;
                frame: root.frame-current; frames: root.frame-frames;
                video-width: root.frame-video-width; video-height: root.frame-video-height;
                frame-label: root.frame-frame-label; clock: root.frame-clock;
                sharp-note: root.frame-sharp-note; selected-label: root.frame-selected-label;
                crop-x: root.frame-crop-x; crop-y: root.frame-crop-y;
                crop-w: root.frame-crop-w; crop-h: root.frame-crop-h;
                crop-visible: root.frame-crop-visible;
                selected-count: root.frame-selected-count; can-capture: root.frame-can-capture;
                left-open: root.frame-left-open; inspector-open: root.frame-inspector-open;
                action(name) => { root.frame-action(name); }
                inspector-tab-selected(tab) => { root.frame-inspector-tab-selected(tab); }
                select(index) => { root.frame-select(index); }
                toggle(index) => { root.frame-toggle(index); }
                remove(index) => { root.frame-remove(index); }
                layout(id) => { root.frame-layout(id); }
                destination(id) => { root.frame-destination(id); }
                scrub(fraction, fast) => { root.frame-scrub(fraction, fast); }
                scrub-end(fraction) => { root.frame-scrub-end(fraction); }
                crop-set(x, y) => { root.frame-crop-set(x, y); }
                crop-move(dx, dy) => { root.frame-crop-move(dx, dy); }
                volume-changed(value) => { root.frame-volume-changed(value); }
                file-dropped(data) => { root.frame-dropped(data); }
                reveal(index) => { root.frame-reveal(index); }
            }
            if root.page == 3 : SettingsPage {
                width: parent.width;
                height: parent.height;
                shell-strings: root.shell-strings;
                prefs: root.prefs;
                jump-to: root.settings-jump;
                category <=> root.settings-category;
                tools: root.tools;
                writable: root.settings-writable;
                error: root.settings-error;
                profile-path: root.profile-path;
                build-label: root.build-label;
                library-limit: root.library-limit;
                storage-used: root.storage-used;
                app-size: root.app-size;
                workspace-size: root.workspace-size;
                components: root.components;
                ffmpeg-ready: root.ffmpeg-ready;
                ffmpeg-installing: root.ffmpeg-installing;
                folders: root.folders;
                set-pref(key, value) => { root.set-pref(key, value); }
                preview-accent(hue) => { root.preview-accent(hue); }
                set-tool-enabled(id, on) => { root.set-tool-enabled(id, on); }
                action(name) => { root.dock-action(name); }
                reset => { root.reset-settings(); }
                search(value) => { return root.search-settings(value); }
            }
            // Keep feedback visible after removing the global bar; this is a dismissible message, not a header.
            if root.notice != "" : Rectangle {
                x: 12px; y: parent.height - self.height - 12px;
                width: min(600px, parent.width - 24px); height: 56px;
                background: Theme.chrome; border-radius: Theme.radius-control;
                border-width: 1px; border-color: Theme.line;
                HorizontalLayout {
                    padding: 10px; spacing: 8px;
                    Text { horizontal-stretch: 1; min-width: 0px; text: root.notice; color: Theme.muted; wrap: word-wrap; overflow: elide; }
                    AppButton { text: root.shell-strings.dismiss; small: true; quiet: true; clicked => { root.dismiss-notice(); } }
                }
            }
        }

        // Sidebar, the full height of the window (§6); drawn last so its tooltips sit above the page
        if root.diagnostic-scene != 0 && root.side > 0px : Rectangle {
            x: 0px;
            y: 0px;
            width: root.side;
            height: parent.height;
            background: Theme.chrome;
            clip: root.page == 0;

            // The hover and selection pills behind the rows
            rail-pills := PillList {
                // No sidebar row stands for a tool's page: no selection pill there
                has-selection: root.page == 3 || root.page == 4 || root.page == 5;
                bar: true;
                select-fill: Theme.raised-flat;
                hover-fill: Theme.raised-flat;
                raised-select: true;
                raised-hover: true;
                y: 0px;
                height: parent.height;
            }

            // Home and the sidebar toggle are icon-only neighbours, not navigation rows. No hover text in either state.
            HorizontalLayout {
                y: 0px;
                height: Theme.bar;
                padding-top: 2px;
                padding-bottom: 2px;
                padding-left: 1px;
                padding-right: 1px;
                spacing: 0px;
                alignment: start;
                sidebar-toggle := BarButton {
                    width: 30px;
                    icon: root.rail-open ? "panel-left-close" : "panel-left-open";
                    label: root.rail-open ? "Collapse the sidebar" : "Expand the sidebar";
                    key: "Ctrl+B";
                    bubble: false;
                    activated => { root.rail-open = !root.rail-open; }
                }
                home-button := BarButton {
                    width: 30px;
                    icon: "house";
                    label: "Home";
                    bubble: false;
                    activated => { root.navigate(0); }
                }
            }

            VerticalLayout {
                y: Theme.bar;
                height: parent.height - Theme.bar;
                padding: 8px;
                padding-right: 9px;
                spacing: 0px;
                // Every row takes an equal share of the height and every group the same fixed gap, so the list is
                // justified top to bottom with one rhythm

                for tool[index] in root.active-tools : VerticalLayout {
                    spacing: 0px;
                    vertical-stretch: 1;
                    if index == 0 || tool.group != root.active-tools[index - 1].group : SidebarGroup {
                        label: root.group-name(tool.group);
                        open: root.rail-open;
                        covered-by-fusion: rail-pills.fusion-covers(self.absolute-position.y + self.height / 2);
                    }
                    SidebarItem {
                        icon: tool.icon;
                        label: tool.name;
                        open: root.rail-open;
                        active: (root.page == 4 && tool.id == "converter") || (root.page == 5 && tool.id == "frame-capture");
                        activated => { root.tool-activated(tool.id); }
                        hovered(on, at, size) => { rail-pills.hover(on, at, size); }
                        selected(at, size, snap) => { rail-pills.select(at, size, snap); }
                    }
                }
                SidebarGroup { label: ""; open: root.rail-open; }
                SidebarItem {
                    icon: "settings"; label: root.settings-label;
                    open: root.rail-open; active: root.page == 3;
                    activated => { root.navigate(3); }
                    hovered(on, at, size) => { rail-pills.hover(on, at, size); }
                    selected(at, size, snap) => { rail-pills.select(at, size, snap); }
                }
            }
        }
    }
    if root.export-choice-visible : Rectangle {
        width: parent.width; height: parent.height;
        background: #00000099;
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 440px; height: 230px;
            background: Theme.popover; border-radius: Theme.radius; border-width: 1px; border-color: Theme.line-hover;
            VerticalLayout {
                padding: 24px; spacing: 14px;
                Text { text: "Where should Halation save your files?"; color: Theme.text; font-size: Theme.font-heading; wrap: word-wrap; }
                Text { text: "Ask every time is recommended. You can change this in Settings → Files."; color: Theme.muted; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    AppButton { text: "Ask every time"; primary: true; clicked => { root.set-pref("save-mode", "0"); root.export-choice-visible = false; root.converter-action("run"); } }
                    AppButton { text: "Halation folder"; clicked => { root.set-pref("save-mode", "1"); root.export-choice-visible = false; root.converter-action("run"); } }
                }
                AppButton { text: "Cancel"; quiet: true; clicked => { root.export-choice-visible = false; } }
            }
        }
    }
}
