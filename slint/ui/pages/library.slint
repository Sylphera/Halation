import { Theme } from "../theme.slint";
import { ToolIcon } from "../icons.slint";
import { AppButton } from "../components/button.slint";
import { Tag } from "../components/controls.slint";
import { PageTitle } from "settings.slint";
import { LibraryRow, SectionRow, ItemRow } from "../models.slint";
import { SectionsView } from "sections.slint";
import { ListView } from "std-widgets.slint";

// Library in the original's frame: title at the top left, a tab bar with the page actions, a search field, then the
// list. Two views: references (files kept where they are) and sections.
export component LibraryPage inherits Rectangle {
    in property <[LibraryRow]> rows;
    in property <string> query: "";
    in property <int> total: 0;
    in property <int> missing: 0;
    in property <bool> loaded: false;
    in property <bool> busy: false;
    in property <bool> writable: false;
    in property <string> error: "";
    in property <duration> motion-duration: 160ms;
    in property <[SectionRow]> sections;
    in property <[ItemRow]> section-items;
    in property <string> section-name: "";
    in property <string> section-kind: "";
    in property <string> section-id: "";
    in property <int> section-hidden: 0;
    in property <bool> sections-loaded: false;
    in property <bool> sections-busy: false;
    // Presentation only: 0 = references, 1 = sections
    in-out property <int> mode: 0;

    callback choose-reference();
    callback select-section(string);
    callback create-section(string);
    callback rename-section(string, string);
    callback delete-section(string);
    callback link-folder();
    callback unlink-folder(string);
    callback sections-opened();
    callback remove-reference(string);
    callback set-query(string);

    PageTitle {
        x: 24px;
        y: 11px;
        icon: "library";
        title: "Library";
    }

    VerticalLayout {
        x: 26px;
        y: 52px;
        width: root.width - 52px;
        height: root.height - 52px - 24px;
        spacing: 12px;

        // Tab bar with the page actions
        Rectangle {
            height: 48px;
            border-radius: Theme.radius-panel;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.hairline;
            Rectangle {
                x: 20px;
                y: 1px;
                width: parent.width - 40px;
                height: 1px;
                background: Theme.sheen;
            }
            HorizontalLayout {
                padding: 9px;
                padding-left: 10px;
                spacing: 2px;
                for label[index] in ["References", "Sections"] : Rectangle {
                    width: tab-label.preferred-width + 22px;
                    border-radius: 14px;
                    background: root.mode == index ? Theme.raised : (tab-touch.has-hover ? #ffffff0d : transparent);
                    accessible-role: tab;
                    accessible-label: label;
                    accessible-item-selected: root.mode == index;
                    accessible-action-default => {
                        root.mode = index;
                        if (index == 1) { root.sections-opened(); }
                    }
                    animate background { duration: root.motion-duration; easing: ease-out; }
                    tab-label := Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: label;
                        color: root.mode == index ? Theme.text : Theme.muted;
                        font-size: Theme.font-title;
                        font-weight: 600;
                    }
                    tab-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.mode = index;
                            if (index == 1) { root.sections-opened(); }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.busy : VerticalLayout {
                    alignment: center;
                    Tag { text: "Saving"; ink: Theme.accent; }
                }
                if root.mode == 0 : AppButton {
                    small: true;
                    icon: "upload";
                    text: "Add";
                    enabled: root.loaded && root.writable && !root.busy;
                    clicked => { root.choose-reference(); }
                }
            }
        }

        if root.mode == 0 : HorizontalLayout {
            height: 36px;
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.radius-field;
                background: Theme.panel;
                border-width: input.has-focus ? 2px : 1px;
                border-color: input.has-focus ? Theme.accent : Theme.hairline;
                ToolIcon {
                    x: 12px;
                    y: (parent.height - self.height) / 2;
                    name: "search";
                    size: 15px;
                    tint: Theme.subtle;
                }
                input := TextInput {
                    x: 35px;
                    width: parent.width - 47px;
                    height: parent.height;
                    single-line: true;
                    vertical-alignment: center;
                    text: root.query;
                    color: Theme.text;
                    font-size: Theme.font-title;
                    accessible-role: text-input;
                    accessible-label: "Filter references";
                    edited => { root.set-query(self.text); }
                }
                if root.query == "" : Text {
                    x: 35px;
                    y: (parent.height - self.height) / 2;
                    text: "Search everything...";
                    color: Theme.subtle;
                    font-size: Theme.font-title;
                }
            }
            if root.total > 0 : Text {
                text: root.total + (root.total == 1 ? " reference" : " references");
                color: Theme.subtle;
                font-size: Theme.font-body;
                vertical-alignment: center;
            }
            if root.missing > 0 : VerticalLayout {
                alignment: center;
                Tag { text: root.missing + " missing"; ink: Theme.danger; }
            }
        }

        if root.error != "" : Rectangle {
            height: 36px;
            border-radius: 12px;
            background: #2a1717;
            Text {
                x: 14px;
                width: parent.width - 28px;
                y: (parent.height - self.height) / 2;
                text: root.error;
                color: Theme.danger;
                font-size: Theme.font-body;
                overflow: elide;
            }
        }

        if root.mode == 0 && !root.loaded : Text {
            vertical-stretch: 1;
            text: "Reading your Library…";
            color: Theme.muted;
            font-size: Theme.font-title;
        }

        if root.mode == 0 && root.loaded && root.rows.length == 0 : Text {
            vertical-stretch: 1;
            text: root.total == 0
                ? "Nothing here yet. Add files of this PC with Add, or drop them on Home; they stay where they are."
                : "No matches. Try a different name or path.";
            color: Theme.muted;
            font-size: Theme.font-title;
            wrap: word-wrap;
        }

        if root.mode == 0 && root.loaded && root.rows.length > 0 : Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-panel;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.hairline;
            clip: true;

            ListView {
                width: parent.width;
                height: parent.height;
                for row in root.rows : Rectangle {
                    height: 60px;
                    width: parent.width;
                    background: row-hover.has-hover ? #ffffff08 : transparent;
                    Rectangle {
                        x: 14px;
                        y: parent.height - 1px;
                        width: parent.width - 28px;
                        height: 1px;
                        background: Theme.hairline;
                    }
                    row-hover := TouchArea { }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 10px;
                                background: Theme.raised;
                                ToolIcon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    name: "library";
                                    size: 17px;
                                    tint: Theme.muted;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: row.name;
                                color: Theme.text;
                                font-size: Theme.font-title;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: row.path;
                                color: Theme.subtle;
                                font-size: Theme.font-small;
                                overflow: elide;
                            }
                        }
                        if row.missing : VerticalLayout {
                            alignment: center;
                            Tag { text: "Missing"; ink: Theme.danger; }
                        }
                        VerticalLayout {
                            alignment: center;
                            AppButton {
                                small: true;
                                text: "Remove";
                                enabled: root.writable && !root.busy;
                                clicked => { root.remove-reference(row.id); }
                            }
                        }
                    }
                }
            }
        }

        if root.mode == 1 : SectionsView {
            vertical-stretch: 1;
            sections: root.sections;
            items: root.section-items;
            selected-id: root.section-id;
            selected-name: root.section-name;
            selected-kind: root.section-kind;
            hidden: root.section-hidden;
            loaded: root.sections-loaded;
            busy: root.sections-busy;
            motion-duration: root.motion-duration;
            select-section(id) => { root.select-section(id); }
            create-section(name) => { root.create-section(name); }
            rename-section(id, name) => { root.rename-section(id, name); }
            delete-section(id) => { root.delete-section(id); }
            link-folder => { root.link-folder(); }
            unlink-folder(id) => { root.unlink-folder(id); }
        }
    }
}
