export global Theme {
    in-out property <color> background: #0b0b0d;
    in-out property <color> surface: #141416;
    in-out property <color> surface-high: #1b1b1f;
    in-out property <color> border: #2c2c32;
    in-out property <color> text: #f4f4f5;
    in-out property <color> muted: #a7a7ae;
    in-out property <color> accent: #b4b8e8;
    in-out property <color> accent-soft: #2a2c43;
    in-out property <color> danger: #f3a6a6;
    in-out property <color> success: #a6d8b4;

    in-out property <length> rail-width: 58px;
    in-out property <length> radius-large: 18px;
    in-out property <length> radius-medium: 11px;
    in-out property <length> page-padding: 26px;
}
