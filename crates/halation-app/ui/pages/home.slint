import { Theme } from "../theme.slint";
import { Assets } from "../assets.slint";
import { ToolIcon } from "../icons.slint";
import { RecentItem } from "../models.slint";
import { Motion, Curve } from "../motion.slint";
import { Surface, Level } from "../components/surface.slint";

// Home as in the original (Java, 2026-10-22: back to it, inside the curved frame): the wordmark (no mark), the
// tagline and drop zone with recent files anchored to the bottom. Tools are reached from the sidebar. Surfaces and corners use
// the frame's tokens: the panel fill, a faint line and the one radius.
export component HomePage inherits Rectangle {
    in property <[RecentItem]> recent;
    in property <bool> library-loaded: false;

    callback choose-reference();
    callback file-dropped(data-transfer);

    // The hero's top edge follows the window's middle; the drop zone keeps 70 px to the bottom
    property <length> hero-top: max(24px, root.height / 2 - 240px);
    property <length> drop-top: max(root.hero-top + 138px, root.height - 36px - 72px - 14px - 196px);

    // The wordmark's halation glow (docs/features/material.md), a prepared image: no blur runs on Home
    Image {
        x: (parent.width - 600px) / 2 - 180px;
        y: root.hero-top - 180px;
        width: 960px;
        height: 428px;
        source: Assets.wordmark-glow;
        image-fit: fill;
        accessible-role: none;
    }
    // The name alone, no mark (Java, 2026-10-22): Bodoni Moda 600, tracked 0.20 em, as outlines; 88 px ("bastante
    // más grande" than the 60 px first chosen)
    Image {
        x: (parent.width - self.width) / 2;
        y: root.hero-top;
        width: 600px;
        height: 68.2px;
        source: Assets.wordmark;
        colorize: Theme.wordmark;
        image-fit: contain;
        accessible-role: image;
        accessible-label: "Halation";
    }

    Text {
        x: (parent.width - self.width) / 2;
        y: root.hero-top + 90px;
        text: "Take your time. Everything else is instant.";
        color: Theme.muted;
        font-size: Theme.font-title;
    }

    // Drop zone
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.drop-top;
        // Taller and wider, recent files lower (Java, 2026-10-22)
        width: min(780px, parent.width - 48px);
        height: 196px;
        // Keep the card's base fill fixed. Pointer light is local, never a veil over the complete interior.
        Surface {
            level: Level.bubble;
            glass: true;
            radius: Theme.radius;
        }
        drop-light := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            border-radius: Theme.radius;
            property <length> reach: drop-area.has-drag ? 420px : 160px;
            property <length> at-x: drop-touch.has-hover ? drop-touch.mouse-x : self.width / 2;
            property <length> at-y: drop-touch.has-hover ? drop-touch.mouse-y : self.height / 2;
            property <color> light: Theme.text.transparentize(drop-touch.has-hover || drop-area.has-drag ? 92% : 100%);
            animate light { duration: Motion.hover(drop-touch.has-hover || drop-area.has-drag); easing: Curve.ease; }
            background: @radial-gradient(circle self.reach at self.at-x self.at-y, self.light 0%, transparent 72%);
        }
        Rectangle {
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: drop-area.has-drag || drop-focus.has-focus ? Theme.accent : drop-touch.has-hover ? Theme.line-hover : Theme.accent.transparentize(1);
            animate border-color { duration: Motion.hover(drop-touch.has-hover || drop-area.has-drag); easing: Curve.ease; }
        }
        // Grows a little under a dragged file, sinks a little on press
        // (nothing scales with reduced motion, when the press scale is 100 %)
        // Both axes set explicitly: animating them with only the `transform-scale` shorthand set leaves them at 0 (Slint 1.18)
        transform-scale-x: Motion.press-scale >= 100% ? 100% : drop-touch.pressed ? 99% : drop-area.has-drag ? 101% : 100%;
        transform-scale-y: self.transform-scale-x;
        animate transform-scale-x, transform-scale-y { duration: drop-touch.pressed ? 0ms : Motion.glide; easing: spring(0); }


        Rectangle {
            x: (parent.width - self.width) / 2;
            // The restored pointer light does not move the icon; only drag feedback raises it.
            y: drop-area.has-drag ? 46px : 48px;
            width: 48px;
            height: 48px;
            animate y { duration: Motion.hover(drop-area.has-drag); easing: Curve.ease; }
            Surface {
                level: Level.raised;
                radius: Theme.radius;
            }
            ToolIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: "upload";
                size: 22px;
                tint: Theme.text;
            }
        }

        Text {
            x: (parent.width - self.width) / 2;
            y: 110px;
            text: drop-area.has-drag ? "Drop to add it to your Library" : "Drop a song or an image";
            color: Theme.text;
            font-size: 15.5px;
            font-weight: 600;
        }
        Text {
            x: (parent.width - self.width) / 2;
            y: 135px;
            text: "Or click to browse. Files are added to your Library, never copied.";
            color: Theme.subtle;
            font-size: Theme.font-body;
        }

        drop-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                drop-focus.focus();
                root.choose-reference();
            }
        }
        drop-focus := FocusScope {
            width: 0px;
            height: 0px;
            focus-on-tab-navigation: true;
            accessible-role: button;
            accessible-label: "Drop a song or an image, or click to browse";
            accessible-action-default => { root.choose-reference(); }
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == Key.Space) {
                    root.choose-reference();
                    accept
                } else {
                    reject
                }
            }
        }
        drop-area := DropArea {
            can-drop(event) => { DragAction.copy }
            dropped(event) => {
                root.file-dropped(event.data);
                event.proposed-action
            }
        }
    }

    // Recent files: as wide as the drop zone, its label over the files or the description, centred like it
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.drop-top + 196px + 14px;
        width: min(780px, parent.width - 48px);
        height: 72px;
        Surface {
            level: Level.bubble;
            glass: true;
            radius: Theme.radius;
        }
        Text {
            x: (parent.width - self.width) / 2;
            y: 17px;
            text: "RECENT FILES";
            color: Theme.subtle;
            font-size: Theme.font-label;
            font-weight: 600;
            letter-spacing: Theme.label-tracking;
        }
        if root.recent.length == 0 : Text {
            x: 24px;
            y: 37px;
            width: parent.width - 48px;
            horizontal-alignment: center;
            text: root.library-loaded ? "Files you add to the Library show up here." : "Reading your Library…";
            color: Theme.muted;
            font-size: Theme.font-small;
            overflow: elide;
        }
        if root.recent.length > 0 : HorizontalLayout {
            x: 24px;
            y: 37px;
            width: parent.width - 48px;
            height: 18px;
            spacing: 16px;
            alignment: center;
            for item in root.recent : Text {
                text: item.name;
                color: Theme.muted;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
                max-width: 160px;
            }
        }
    }
}
