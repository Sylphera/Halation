import { Theme } from "../theme.slint";
import { ToolIcon } from "../icons.slint";

// One entry of the sidebar: a 28 px row with icon and label. Collapsed, only the icon shows and a tooltip gives the
// name on hover and keyboard focus.
export component SidebarItem inherits FocusScope {
    in property <string> icon: "download";
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> open: true;
    in property <duration> motion-duration: 160ms;
    callback activated;

    height: Theme.item;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: label;
    accessible-item-selected: active;
    accessible-action-default => { activated(); }

    key-pressed(event) => {
        if (event.text == Key.Return || event.text == Key.Space) {
            activated();
            accept
        } else {
            reject
        }
    }

    Rectangle {
        border-radius: Theme.radius-control;
        background: root.active ? Theme.control-active : (touch.pressed ? Theme.press-fill : (touch.has-hover ? Theme.control-hover : transparent));
        border-width: root.has-focus ? 2px : 0px;
        border-color: Theme.accent;
    }

    ToolIcon {
        x: root.open ? 8px : (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        size: 16px;
        tint: root.active ? Theme.accent : (touch.has-hover ? Theme.text : Theme.muted);
    }

    if root.open : Text {
        x: 32px;
        y: (parent.height - self.height) / 2;
        width: max(0px, parent.width - 40px);
        text: root.label;
        color: root.active || touch.has-hover ? Theme.text : Theme.muted;
        font-size: Theme.font-body;
        font-weight: 500;
        overflow: elide;
    }

    // Tooltip of the collapsed sidebar: an overlay to the right
    if !root.open && (touch.has-hover || root.has-focus) : Rectangle {
        x: parent.width + 12px;
        y: (parent.height - self.height) / 2;
        width: tip.preferred-width + 20px;
        height: 26px;
        border-radius: Theme.radius-overlay;
        background: Theme.control;
        border-width: 1px;
        border-color: Theme.line-strong;
        tip := Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-small;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.focus();
            root.activated();
        }
    }
}

// The label over a group of tools; collapsed, a 1 px line in its place
export component SidebarGroup inherits Rectangle {
    in property <string> label;
    in property <bool> open: true;
    height: root.open ? 26px : 13px;
    if root.open : Text {
        x: 8px;
        y: parent.height - self.height - 4px;
        text: root.label;
        color: Theme.subtle;
        font-size: Theme.font-caption;
        font-weight: 500;
    }
    if !root.open : Rectangle {
        x: 8px;
        y: 6px;
        width: parent.width - 16px;
        height: 1px;
        background: Theme.line;
    }
}
