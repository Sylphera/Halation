import { Theme } from "../theme.slint";
import { Motion, Curve } from "../motion.slint";

// Shared media controls, used by Converter and Frame Capture. Rust owns their state; they only present it and ask
// for actions.

// A round transport button with a drawn glyph (filled path in a 24 × 24 box)
export component RoundButton inherits FocusScope {
    in property <string> glyph;
    in property <string> name;
    in property <bool> primary: false;
    in property <bool> stroke: false;
    callback clicked;
    width: root.primary ? 36px : 30px;
    height: self.width;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == Key.Space) { root.clicked(); accept } else { reject }
    }
    Rectangle {
        border-radius: self.height / 2;
        background: root.primary
            ? (touch.pressed ? Theme.primary-fill-press : Theme.primary-fill)
            : (touch.pressed ? Theme.press-fill : touch.has-hover ? Theme.hover-fill : Theme.hover-fill.transparentize(1));
        border-width: root.has-focus ? 2px : 0px;
        border-color: Theme.accent;
        animate background { duration: Motion.hover(touch.has-hover); easing: Curve.ease; }
    }
    Path {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: root.primary ? 14px : 15px; height: self.width;
        viewbox-width: 24; viewbox-height: 24;
        commands: root.glyph;
        fill: root.stroke ? transparent : (root.primary ? Theme.chrome : Theme.muted);
        stroke: root.stroke ? Theme.muted : transparent;
        stroke-width: root.stroke ? 2px : 0px;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.focus(); root.clicked(); } }
}

// A horizontal value bar: drag or click to set it. `report` fires while dragging, `commit` on release.
export component Scrubber inherits Rectangle {
    in property <float> value;
    in property <string> name;
    in property <string> value-text;
    callback report(float);
    callback commit(float);
    out property <bool> dragging: false;
    property <float> held: 0;
    property <float> shown: self.dragging ? self.held : root.value;
    height: 20px;
    accessible-role: slider;
    accessible-label: root.name;
    accessible-value: root.value-text;
    Rectangle { x: 0px; y: (parent.height - 4px) / 2; width: parent.width; height: 4px; border-radius: 2px; background: Theme.line-strong; }
    Rectangle { x: 0px; y: (parent.height - 4px) / 2; width: parent.width * root.shown; height: 4px; border-radius: 2px; background: Theme.accent; }
    Rectangle {
        x: (parent.width - self.width) * root.shown; y: (parent.height - self.height) / 2;
        width: 12px; height: 12px; border-radius: 6px; background: Theme.text;
        opacity: touch.has-hover || root.dragging ? 1 : 0.85;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.dragging = true;
                root.held = clamp(self.mouse-x / self.width, 0, 1);
                root.report(root.held);
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.commit(root.held);
            }
            if (event.kind == PointerEventKind.cancel) { root.dragging = false; }
        }
        moved => {
            if (root.dragging) { root.held = clamp(self.mouse-x / self.width, 0, 1); root.report(root.held); }
        }
    }
}

// Back, play/pause, forward, the clock, an optional seek bar (video) and the volume. Rust owns the state.
export component Transport inherits HorizontalLayout {
    in property <bool> playing;
    in property <string> clock;
    in property <float> position;
    in property <float> volume;
    in property <bool> track: false;
    // Screen-reader names; Frame Capture steps one second, Converter five
    in property <string> back-name: "Back 5 seconds";
    in property <string> forward-name: "Forward 5 seconds";
    callback action(string);
    callback seek(float);
    callback volume-changed(float);
    height: 36px;
    spacing: 6px;
    alignment: stretch;
    VerticalLayout { alignment: center; RoundButton { name: root.back-name; glyph: "M11 7 L4 12 L11 17 Z M19 7 L12 12 L19 17 Z"; clicked => { root.action("back"); } } }
    RoundButton {
        primary: true;
        name: root.playing ? "Pause" : "Play";
        glyph: root.playing ? "M6 4 H10 V20 H6 Z M14 4 H18 V20 H14 Z" : "M7 4 L20 12 L7 20 Z";
        clicked => { root.action("play"); }
    }
    VerticalLayout { alignment: center; RoundButton { name: root.forward-name; glyph: "M5 7 L12 12 L5 17 Z M13 7 L20 12 L13 17 Z"; clicked => { root.action("forward"); } } }
    Rectangle { width: 6px; }
    Text { text: root.clock; color: Theme.muted; font-size: Theme.font-body; vertical-alignment: center; }
    Rectangle { width: 10px; }
    if root.track : VerticalLayout {
        alignment: center; horizontal-stretch: 1;
        Scrubber { name: "Position"; value: root.position; value-text: root.clock; commit(v) => { root.seek(v); } }
    }
    if !root.track : Rectangle { horizontal-stretch: 1; }
    Rectangle { width: 10px; }
    VerticalLayout {
        alignment: center;
        RoundButton {
            name: root.volume > 0 ? "Mute" : "Unmute";
            stroke: true;
            glyph: root.volume > 0
                ? "M4 9 H8 L13 5 V19 L8 15 H4 Z M16.5 9 C18 10.5 18 13.5 16.5 15 M19 6.5 C22 9.5 22 14.5 19 17.5"
                : "M4 9 H8 L13 5 V19 L8 15 H4 Z M16 9 L22 15 M22 9 L16 15";
            clicked => { root.action("mute"); }
        }
    }
    VerticalLayout {
        alignment: center;
        Scrubber {
            width: 88px; name: "Volume"; value: root.volume; value-text: round(root.volume * 100) + " %";
            report(v) => { root.volume-changed(v); }
            commit(v) => { root.volume-changed(v); }
        }
    }
}
