export struct ToolItem {
    id: string,
    name: string,
    icon: string,
    available: bool,
    reason: string,
}

export struct LibraryRow {
    id: string,
    name: string,
    path: string,
    missing: bool,
}

export struct JobRow {
    id: string,
    name: string,
    detail: string,
    state: string,
    progress: float,
    has-progress: bool,
    cancellable: bool,
    finished: bool,
    failed: bool,
}

export struct RecentItem {
    id: string,
    name: string,
}
