import { Theme } from "../theme.slint";
import { ToolIcon } from "../icons.slint";
import { AppButton } from "../components/button.slint";
import { JobRow } from "../models.slint";
import { ListView } from "std-widgets.slint";

export component JobsPage inherits Rectangle {
    in property <[JobRow]> jobs;
    in property <string> capability: "";
    in property <bool> has-finished: false;
    in property <duration> motion-duration: 160ms;

    callback cancel-job(string);
    callback clear-finished();

    background: transparent;

    VerticalLayout {
        padding: Theme.page-padding;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Jobs";
                color: Theme.text;
                font-size: 27px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 154px;
                height: 24px;
                border-radius: 12px;
                background: #2a1c1c;
                border-width: 1px;
                border-color: Theme.danger;
                y: (parent.height - self.height) / 2;
                Text {
                    text: "DISCONNECTED";
                    color: Theme.danger;
                    font-size: 8px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            AppButton {
                text: "Clear finished";
                compact: true;
                enabled: root.has-finished;
                clicked => { root.clear-finished(); }
            }
        }

        Text {
            text: "The queue and process engine are live, but no tool is connected in this beta: nothing can be added here. Nothing pretends to run.";
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        if root.jobs.length == 0 : Rectangle {
            vertical-stretch: 1;
            border-radius: 16px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                alignment: center;
                spacing: 9px;
                ToolIcon { name: "jobs"; tint: Theme.muted; }
                Text {
                    text: "No jobs";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.capability;
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.jobs.length > 0 : ListView {
            vertical-stretch: 1;
            for job in root.jobs : Rectangle {
                height: 66px;
                width: parent.width;
                border-radius: 9px;
                background: Theme.surface;
                border-width: 1px;
                border-color: job.failed ? Theme.danger : Theme.border;
                clip: true;

                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 3px;
                        horizontal-stretch: 1;
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: job.name;
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: job.state;
                                color: job.failed ? Theme.danger : (job.finished ? Theme.success : Theme.accent);
                                font-size: 10px;
                                font-weight: 600;
                            }
                        }
                        Text {
                            text: job.detail;
                            color: Theme.muted;
                            font-size: 9px;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.surface-high;
                            Rectangle {
                                x: 0px;
                                height: parent.height;
                                width: job.has-progress ? parent.width * job.progress : 0px;
                                border-radius: 2px;
                                background: job.failed ? Theme.danger : Theme.accent;
                                animate width { duration: root.motion-duration; easing: ease-out; }
                            }
                        }
                    }
                    if !job.finished : AppButton {
                        text: "Cancel";
                        compact: true;
                        enabled: job.cancellable;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.cancel-job(job.id); }
                    }
                }
            }
        }

        Text {
            text: "Finished jobs stay until cleared; the engine keeps the last 50.";
            color: Theme.muted;
            font-size: 9px;
        }
    }
}
