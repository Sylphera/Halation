import { Theme } from "../theme.slint";
import { ToolIcon } from "../icons.slint";
import { AppButton } from "../components/button.slint";
import { LibraryRow } from "../models.slint";
import { ListView } from "std-widgets.slint";

export component LibraryPage inherits Rectangle {
    in property <[LibraryRow]> rows;
    in property <string> query: "";
    in property <int> total: 0;
    in property <int> missing: 0;
    in property <bool> loaded: false;
    in property <bool> busy: false;
    in property <bool> writable: false;
    in property <string> error: "";
    in property <string> notice: "";
    in property <duration> motion-duration: 160ms;

    callback choose-reference();
    callback remove-reference(string);
    callback set-query(string);
    callback open-settings();
    callback dismiss-notice();

    background: transparent;

    VerticalLayout {
        padding: Theme.page-padding;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Library";
                color: Theme.text;
                font-size: 27px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.busy : Text {
                text: "Saving…";
                color: Theme.accent;
                font-size: 11px;
                vertical-alignment: center;
            }
            AppButton {
                text: "Add reference";
                primary: true;
                enabled: root.loaded && root.writable && !root.busy;
                clicked => { root.choose-reference(); }
            }
        }

        Text {
            text: "References, not copies. Adding or removing an entry never moves or deletes the original file."
                + (root.total > 0 ? "  ·  " + root.total + " references" + (root.missing > 0 ? "  ·  " + root.missing + " missing" : "") : "");
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }

        if root.error != "" : Rectangle {
            height: 34px;
            border-radius: 8px;
            background: #2a1c1c;
            border-width: 1px;
            border-color: Theme.danger;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                ToolIcon { name: "warning"; tint: Theme.danger; }
                Text {
                    text: root.error;
                    color: Theme.danger;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        if root.notice != "" : Rectangle {
            height: 30px;
            border-radius: 8px;
            background: Theme.accent-soft;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: root.notice;
                    color: Theme.accent;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Dismiss";
                    color: Theme.accent;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.dismiss-notice(); } }
        }

        Rectangle {
            height: 38px;
            border-radius: 9px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding: 10px;
                spacing: 8px;
                ToolIcon { name: "search"; tint: Theme.muted; }
                input := TextInput {
                    single-line: true;
                    text: root.query;
                    color: Theme.text;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    edited => { root.set-query(input.text); }
                }
            }
            if root.query == "" : Text {
                text: "Filter by name or path…";
                color: Theme.muted;
                font-size: 12px;
                x: 36px;
                y: (parent.height - self.height) / 2;
            }
        }

        if !root.loaded : Rectangle {
            vertical-stretch: 1;
            background: transparent;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: "Loading references…";
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Index and file metadata are read off the UI thread.";
                    color: Theme.muted;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }

        if root.loaded && root.rows.length == 0 : Rectangle {
            vertical-stretch: 1;
            background: transparent;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                ToolIcon { name: "library"; tint: Theme.muted; }
                Text {
                    text: root.total == 0 ? "No references yet" : "No matches";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.total == 0
                        ? "Add a song or an image with “Add reference”, or drop one on Home."
                        : "Try a different name or path.";
                    color: Theme.muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }
        }

        if root.loaded && root.rows.length > 0 : ListView {
            vertical-stretch: 1;
            for row in root.rows : Rectangle {
                height: 58px;
                width: parent.width;
                border-radius: 9px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding: 10px;
                    spacing: 10px;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 8px;
                        background: Theme.surface-high;
                        ToolIcon {
                            name: "library";
                            tint: Theme.muted;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: row.name;
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: row.path;
                            color: Theme.muted;
                            font-size: 9px;
                            overflow: elide;
                        }
                    }
                    if row.missing : Rectangle {
                        width: 64px;
                        height: 22px;
                        border-radius: 11px;
                        background: #2a1c1c;
                        Text {
                            text: "MISSING";
                            color: Theme.danger;
                            font-size: 8px;
                            font-weight: 700;
                            letter-spacing: 0.5px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    AppButton {
                        text: "Remove";
                        compact: true;
                        enabled: root.writable && !root.busy;
                        clicked => { root.remove-reference(row.id); }
                    }
                }
                row-touch := TouchArea { enabled: false; }
            }
        }

        Text {
            text: "Profile: " + root.total + " / bounded reference index · no deletion, no copying, no Tauri data.";
            color: Theme.muted;
            font-size: 9px;
        }
    }
}
