+  const state = { working: 'Trabajando', waiting: 'En espera', done: 'Terminado', failed: 'Falló', stopped: 'Detenido' };
+  const glyph = { working: '●', waiting: '○', done: '✓', failed: '×', stopped: '■' };
+  const task = (card: TaskView['active'][number]) => {
+    const color = card.state === 'working' || card.state === 'done' ? theme.success ?? theme.text : card.state === 'failed' ? theme.warning ?? theme.text : theme.textMuted;
+    return box({ width: '100%', flexDirection: 'column', paddingTop: 1, shouldFill: false }, [
+      clickable([label(`${glyph[card.state]} ${card.title}`, theme.text, true)], () => interaction?.navigate?.(card.id)),
