import { Theme } from "../theme.slint";

// Primary (light fill, one per view), secondary (surface and border) or ghost (accent text only).
export component AppButton inherits FocusScope {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <bool> ghost: false;
    in property <bool> compact: false;
    in property <duration> motion-duration: 160ms;
    callback clicked;

    width: max(root.compact ? 68px : 96px, label.preferred-width + (root.compact ? 22px : 32px));
    height: root.compact ? 28px : 36px;
    focus-on-tab-navigation: true;

    accessible-role: button;
    accessible-label: text;
    accessible-action-default => {
        if (root.enabled) {
            clicked();
        }
    }

    key-pressed(event) => {
        if (event.text == Key.Return || event.text == Key.Space) {
            if (root.enabled) {
                clicked();
            }
            accept
        } else {
            reject
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: Theme.radius-control;
        background: root.primary
            ? (touch.pressed ? Theme.muted : (touch.has-hover ? Theme.text : Theme.primary))
            : root.ghost
            ? (touch.pressed ? Theme.surface-high : (touch.has-hover ? Theme.surface-raised : transparent))
            : (touch.pressed ? Theme.surface-high : (touch.has-hover ? Theme.surface-raised : Theme.surface));
        border-width: root.has-focus ? 2px : (root.primary || root.ghost ? 0px : 1px);
        border-color: root.has-focus ? Theme.accent : (touch.has-hover ? Theme.border-strong : Theme.border);
        opacity: root.enabled ? 1 : 0.45;
        animate background {
            duration: touch.pressed ? 0ms : root.motion-duration;
            easing: ease-out;
        }
    }

    label := Text {
        text: root.text;
        color: root.primary ? Theme.on-primary : (root.ghost ? Theme.accent : Theme.text);
        font-size: root.compact ? Theme.font-caption : Theme.font-label;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.focus();
            root.clicked();
        }
    }
}
