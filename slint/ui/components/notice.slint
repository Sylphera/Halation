import { Theme } from "../theme.slint";
import { ToolIcon } from "../icons.slint";

// Inline message under a page header. Errors are danger toned and stay until their cause is fixed.
export component Notice inherits Rectangle {
    in property <string> text: "";
    in property <bool> error: false;
    callback dismiss();

    height: 36px;
    border-radius: Theme.radius-control;
    background: root.error ? Theme.danger-soft : Theme.accent-soft;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 10px;
        if root.error : VerticalLayout {
            alignment: center;
            ToolIcon { name: "warning"; tint: Theme.danger; }
        }
        Text {
            text: root.text;
            color: root.error ? Theme.danger : Theme.accent;
            font-size: Theme.font-label;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if !root.error : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 60px;
                height: 24px;
                border-radius: Theme.radius-chip;
                background: dismiss-touch.has-hover ? Theme.surface-high : transparent;
                accessible-role: button;
                accessible-label: "Dismiss";
                accessible-action-default => { root.dismiss(); }
                Text {
                    text: "Dismiss";
                    color: Theme.accent;
                    font-size: Theme.font-caption;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                dismiss-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.dismiss(); }
                }
            }
        }
    }
}
