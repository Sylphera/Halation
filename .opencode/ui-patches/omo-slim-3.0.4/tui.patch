+      label(`  ${card.role} · ${modelLabel(card.model)}`),
+    ]);
+  };
+  return box({ width: '100%', flexDirection: 'column', paddingTop: 1, paddingBottom: 1 }, [
+    clickable([label(`${open ? '▾' : '▸'} OMO · Workers`, theme.text, true)], interaction?.toggleOpen),
+    ...(open ? [
+      label(view.coordinatorActive ? 'Sol · Activo' : view.active.length ? 'Sol · Esperando workers' : 'Sol · En espera'),
+      ...(visibleID !== view.rootID ? [clickable([label('← Coordinador', theme.text)], () => interaction?.navigate?.(view.rootID))] : []),
+      box({ paddingTop: 1, flexDirection: 'column', width: '100%' }, [label(`EN CURSO · ${view.active.length}`, theme.text, true)]),
+      ...(view.active.length ? view.active.map(task) : [label('Sin workers activos')]),
+      box({ paddingTop: 1, width: '100%', flexDirection: 'column' }, [clickable([label(`${historyOpen ? '▾' : '▸'} TERMINADOS · ${view.finished.length}`, theme.text, true)], () => interaction?.toggleAgent('readable-history'))]),
+      ...(historyOpen ? view.finished.slice(0, 12).map(task) : []),
+    ] : []),
+  ]);
