// Tokens of planning/active/ui-redesign.md §5 (anchored frame: flat surfaces and 1 px lines). Rust (`theme.rs`)
// applies the colour values at start-up; the defaults here match them so headless tests and snapshots render the same.
export global Theme {
    // Surfaces, from the frame inwards
    in-out property <color> chrome: #111111;
    in-out property <color> canvas: #0c0c0c;
    in-out property <color> canvas-deep: #0a0a0b;
    in-out property <color> control: #161617;
    in-out property <color> control-hover: #1c1c1e;
    in-out property <color> control-active: #232325;
    // Lines: between regions and rows; control borders and hover
    in-out property <color> line: #1f1f21;
    in-out property <color> line-strong: #2d2d30;
    // A control's border under the pointer
    out property <color> line-hover: #3c3c40;

    in-out property <color> text: #f5f5f2;
    in-out property <color> muted: #b5b5af;
    in-out property <color> subtle: #9a9993;
    in-out property <color> accent: #a3a8dc;
    in-out property <color> activity: #82b5d6;
    in-out property <color> warning: #e0b15e;
    in-out property <color> beta: #e391a4;
    in-out property <color> danger: #f0a6a6;
    in-out property <color> success: #9fd6b2;

    // Hover and pressed fills over anything
    out property <color> hover-fill: #ffffff0f;
    out property <color> press-fill: #ffffff17;
    // The Workspace's panels over the Drape: the canvas at 86%, so the Drape shows faintly through them
    out property <color> panel: #101011dc;

    // Material (docs/features/material.md, direction A, "Relief"): light from above. Each level is a flat fill
    // (Java, 2026-10-22: no top-to-bottom fall-off) with a 1 px edge brighter at the top (the sheen); raised levels
    // stand on a 1 px dark contact edge. No blur. Neutral greys, no blue.
    out property <brush> raised-fill: #232323;
    out property <brush> raised-fill-press: #1c1c1c;
    out property <brush> raised-edge: @linear-gradient(180deg, #ffffff29 0%, #ffffff12 45%, #ffffff0b 100%);
    // The raised fill as a colour, for shapes that must match it (the pills' neck)
    out property <color> raised-flat: #232323;
    // Recessed: fields, tracks, the switch off; dark at the top edge, catching light at the bottom
    out property <brush> well-fill: #090909;
    out property <brush> well-edge: @linear-gradient(180deg, #000000b0 0%, #ffffff0a 35%, #ffffff14 100%);
    // Panels; `glass` over the Drape lets it show faintly through
    out property <brush> bubble-fill: #141414;
    out property <brush> bubble-glass: #141414e0;
    out property <brush> bubble-edge: @linear-gradient(180deg, #ffffff29 0%, #ffffff12 35%, #ffffff0d 100%);
    // Menus and tooltips: one step above raised
    out property <brush> popover-fill: #222222;
    out property <brush> popover-edge: @linear-gradient(180deg, #ffffff30 0%, #ffffff17 100%);
    // The accent as a raised piece (the switch on)
    out property <brush> accent-fill: #a3a8dc;
    out property <brush> accent-edge: @linear-gradient(180deg, #ffffff70 0%, #ffffff14 45%, #00000026 100%);
    // The one white button of a page
    out property <brush> primary-fill: #f5f5f2;
    out property <brush> primary-fill-press: #c9c9c4;
    // The switch's knob, off and on
    out property <brush> knob-light: #f5f5f2;
    out property <brush> knob-dark: #111111;
    // The page sheet, set into the chrome: a darker well with a shaded top edge
    out property <brush> sheet-edge: @linear-gradient(180deg, #000000a0 0%, #ffffff08 6%, #ffffff0a 100%);
    // The 1 px dark edge a raised piece stands on
    out property <color> contact: #000000b3;
    // Rows inside a panel or a section
    out property <color> separator: #ffffff0b;

    // Frame metrics
    out property <length> sidebar-open: 224px;
    out property <length> sidebar-closed: 52px;
    out property <length> bar: 44px;
    out property <length> sub-bar: 36px;
    out property <length> item: 28px;

    // Halation is curved (Java, 2026-10-22): one radius for every corner, controls, menus, panels and the page sheet
    // alike. Slint draws circular corners, so this approximates a squircle by size, not by curve.
    out property <length> radius: 12px;
    out property <length> radius-control: root.radius;
    out property <length> radius-overlay: root.radius;
    out property <length> radius-sheet: root.radius;
    // Gap between the page sheet and the window's right and bottom edges
    out property <length> sheet-inset: 8px;

    out property <length> font-heading: 16px;
    out property <length> font-title: 13.5px;
    out property <length> font-body: 12.5px;
    out property <length> font-small: 12px;
    out property <length> font-caption: 11px;
    // Faces (Java, 2026-10-22, type lab): Schibsted Grotesk for the interface, Italiana for page titles; the
    // wordmark is Bodoni Moda 600, tracked 0.20 em, converted to outlines
    out property <string> ui-face: "Schibsted Grotesk";
    out property <string> display: "Italiana";
    out property <length> font-display: 28px;
    out property <length> font-bar-title: 19px;
    // Group labels: small tracked capitals
    out property <length> font-label: 10.5px;
    out property <length> label-tracking: 0.9px;
}
