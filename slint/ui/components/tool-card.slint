import { Theme } from "../theme.slint";
import { ToolIcon } from "../icons.slint";

// A tool on Home: icon well, name and what it does.
export component ToolCard inherits FocusScope {
    in property <string> name: "";
    in property <string> summary: "";
    in property <string> icon: "download";
    in property <bool> available: false;
    in property <duration> motion-duration: 160ms;
    callback activated;

    height: 64px;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: name + (available ? "" : " (engine not connected in this beta)");
    accessible-description: summary;
    accessible-action-default => { activated(); }

    key-pressed(event) => {
        if (event.text == Key.Return || event.text == Key.Space) {
            activated();
            accept
        } else {
            reject
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: Theme.radius-card;
        background: touch.pressed ? Theme.surface-high : (touch.has-hover ? Theme.surface-raised : Theme.surface);
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? Theme.accent : (touch.has-hover ? Theme.border-strong : Theme.border);
        animate background, border-color {
            duration: touch.pressed ? 0ms : root.motion-duration;
            easing: ease-out;
        }
    }

    Rectangle {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 36px;
        height: 36px;
        border-radius: Theme.radius-control;
        background: Theme.surface-high;
        ToolIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.icon;
            tint: touch.has-hover || root.has-focus ? Theme.text : Theme.muted;
        }
    }

    VerticalLayout {
        x: 60px;
        width: parent.width - 72px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.name;
            color: Theme.text;
            font-size: Theme.font-body;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.summary;
            color: Theme.subtle;
            font-size: Theme.font-caption;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.focus();
            root.activated();
        }
    }
}
