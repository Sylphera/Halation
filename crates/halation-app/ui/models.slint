export struct ToolItem {
    id: string,
    name: string,
    icon: string,
    summary: string,
    group: int,
    beta: bool,
    enabled: bool,
    // Components it still needs, as "Missing: …" shows them; empty when nothing is missing
    missing: string,
    available: bool,
    reason: string,
}

export struct ConvertRow {
    index: int,
    name: string,
    detail: string,
    state: string,
    target: string,
    selected: bool,
    failed: bool,
    // It can leave the list: not converting or queued right now
    removable: bool,
}

export struct FormatRow {
    id: string,
    name: string,
    detail: string,
    selected: bool,
    audio: bool,
    // The first of video's audio-only outputs: shows the "Audio only" caption above it
    header: bool,
    // The suggested output (the first of the curated list)
    recommended: bool,
    // The consequence line (§4.5 of the spec): empty when there is nothing to say
    note: string,
}

// Frame Capture: one queued frame. `n` is the 0-based index; `thumb` is empty until a preview is available.
export struct FrameQueueRow {
    index: int,
    n: int,
    label: string,
    time: string,
    selected: bool,
    thumb: image,
}

export struct FrameLayoutRow {
    id: string,
    label: string,
    detail: string,
    selected: bool,
}

export struct FrameDestinationRow {
    id: string,
    label: string,
    detail: string,
    selected: bool,
}

export struct FrameResultRow {
    index: int,
    name: string,
    detail: string,
    path: string,
}

// Every visible Frame Capture string, loaded from locales/en.json by Rust. No visible literal lives outside it.
