import { Palette } from "std-widgets.slint";
import { Assets } from "assets.slint";
import { Theme } from "theme.slint";
import { ToolItem, LibraryRow, JobRow, RecentItem, SectionRow, ItemRow, Prefs, ComponentRow, FolderRow } from "models.slint";
export { Theme } from "theme.slint";
export { Assets } from "assets.slint";
export { ToolItem, LibraryRow, JobRow, RecentItem, SectionRow, ItemRow, Prefs, ComponentRow, FolderRow } from "models.slint";
import { WorkspacePage } from "pages/home.slint";
import { SettingsPage } from "pages/settings.slint";
import { SidebarItem, SidebarGroup } from "components/rail-item.slint";
import { TopActions, BarButton } from "components/top-dock.slint";
import { AppButton } from "components/button.slint";
import { SearchField } from "components/controls.slint";

export component AppWindow inherits Window {
    title: "Halation";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.canvas;
    icon: Assets.mark;
    default-font-family: "Inter";
    default-font-size: Theme.font-body;

    init => {
        Palette.color-scheme = ColorScheme.dark;
        root.rail-open = root.auto-open();
        keys.focus();
    }

    // Pages: 0 Workspace (Home, Library and jobs in one page; 1, the Library, shows it too), 3 Settings; 2 is unused
    in property <int> page: 0;
    in property <bool> reduced-motion: false;
    in property <int> diagnostic-scene: 1;
    in property <duration> motion-duration: 160ms;
    in property <string> build-label: "";
    in property <string> profile-path: "";
    in property <string> library-query: "";
    // Home's backdrop: the frame of the Drape loop on screen (Rust's player sets it 15 times a second)
    in property <image> backdrop;
    in property <[ToolItem]> tools;
    in property <[ToolItem]> active-tools;
    in property <[LibraryRow]> library-rows;
    in property <[JobRow]> jobs;
    in property <[RecentItem]> recent;
    in property <int> library-total: 0;
    in property <int> library-missing: 0;
    in property <bool> library-busy: false;
    in property <bool> library-writable: false;
    in property <bool> library-loaded: false;
    in property <string> library-error: "";
    in property <int> library-limit: 2000;
    in property <bool> settings-writable: true;
    in property <string> settings-error: "";
    in property <Prefs> prefs;
    in property <string> notice: "";
    in property <string> jobs-capability: "";
    in property <bool> jobs-has-finished: false;
    in property <bool> jobs-busy: false;
    in property <string> storage-used: "";
    in property <string> app-size: "";
    in property <string> workspace-size: "";
    in property <[ComponentRow]> components;
    in property <[FolderRow]> folders;
    in property <[SectionRow]> sections;
    in property <[ItemRow]> section-items;
    in property <string> section-id: "";
    in property <string> section-name: "";
    in property <string> section-kind: "";
    in property <int> section-hidden: 0;
    in property <bool> sections-loaded: false;
    in property <bool> sections-busy: false;
    // Library tab: 0 references, 1 sections (in-out so a headless snapshot can fix it)
    in-out property <int> library-mode: 0;
    // The sidebar open with labels; closed it shows icons only (planning/active/ui-redesign.md §6)
    in-out property <bool> rail-open: true;
    // Settings category to open at (headless snapshots)
    in property <int> settings-jump: -1;
    // Settings category shown (the top bar's search changes it)
    in-out property <int> settings-category: 0;

    callback navigate(int);
    callback choose-reference();
    callback file-dropped(data-transfer);
    callback remove-reference(string);
    callback set-query(string);
    callback set-reduced-motion(bool);
    callback set-pref(string, string);
    callback set-tool-enabled(string, bool);
    callback reset-settings();
    callback search-settings(string) -> int;
    callback tool-activated(string);
    callback dock-action(string);
    callback dismiss-notice();
    callback cancel-job(string);
    callback clear-finished-jobs();
    callback jobs-changed();
    callback sections-opened();
    callback select-section(string);
    callback create-section(string);
    callback rename-section(string, string);
    callback delete-section(string);
    callback link-folder();
    callback unlink-folder(string);
    callback sections-finished();
    // Internal async notifications; the UI does not trigger these.
    callback load-finished();
    callback save-finished();
    callback references-finished();

    // Open by default from 1180 px of window width, collapsed below; "Keep open" keeps it open and "Compact" closed.
    // The user's toggle wins until the width crosses 1180 px again or the setting changes.
    property <bool> wide: root.width >= 1180px;
    property <int> dock-mode: root.prefs.dock-mode;
    pure function auto-open() -> bool {
        root.dock-mode == 2 || (root.dock-mode == 1 && root.wide)
    }
    changed wide => { root.rail-open = root.auto-open(); }
    changed dock-mode => { root.rail-open = root.auto-open(); }

    property <length> side: root.rail-open ? Theme.sidebar-open : Theme.sidebar-closed;
    animate side { duration: root.motion-duration * 1.6; easing: ease-out; }

    pure function group-name(group: int) -> string {
        group == 1 ? "Get" : group == 2 ? "Audio" : group == 3 ? "Image" : group == 4 ? "Video" : ""
    }

    keys := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "b" || event.text == "B")) {
                root.rail-open = !root.rail-open;
                return accept;
            }
            reject
        }

        // The page, right of the sidebar and under the top bar
        if root.diagnostic-scene != 0 : Rectangle {
            x: root.side;
            y: Theme.bar;
            width: parent.width - root.side;
            height: parent.height - Theme.bar;
            background: Theme.canvas;
            clip: true;

            // The Workspace's backdrop: the recorded Drape and a fixed film grain, only inside its content (§8)
            if root.page <= 1 : Image {
                width: parent.width;
                height: parent.height;
                source: root.backdrop;
                image-fit: cover;
                image-rendering: smooth;
            }
            if root.page <= 1 : Image {
                width: parent.width;
                height: parent.height;
                source: Assets.grain;
                horizontal-tiling: repeat;
                vertical-tiling: repeat;
                // The grain's strength, Java's choice (2026-10-21)
                opacity: 0.1;
            }

            if root.page <= 1 : WorkspacePage {
                width: parent.width;
                height: parent.height;
                rows: root.library-rows;
                total: root.library-total;
                missing: root.library-missing;
                loaded: root.library-loaded;
                busy: root.library-busy;
                writable: root.library-writable;
                error: root.library-error;
                jobs: root.jobs;
                jobs-has-finished: root.jobs-has-finished;
                motion-duration: root.motion-duration;
                mode <=> root.library-mode;
                sections: root.sections;
                section-items: root.section-items;
                section-id: root.section-id;
                section-name: root.section-name;
                section-kind: root.section-kind;
                section-hidden: root.section-hidden;
                sections-loaded: root.sections-loaded;
                sections-busy: root.sections-busy;
                choose-reference => { root.choose-reference(); }
                file-dropped(data) => { root.file-dropped(data); }
                remove-reference(id) => { root.remove-reference(id); }
                sections-opened => { root.sections-opened(); }
                select-section(id) => { root.select-section(id); }
                create-section(name) => { root.create-section(name); }
                rename-section(id, name) => { root.rename-section(id, name); }
                delete-section(id) => { root.delete-section(id); }
                link-folder => { root.link-folder(); }
                unlink-folder(id) => { root.unlink-folder(id); }
                open-activity => { root.dock-action("activity"); }
                cancel-job(id) => { root.cancel-job(id); }
                clear-finished-jobs => { root.clear-finished-jobs(); }
            }

            if root.page == 3 : SettingsPage {
                width: parent.width;
                height: parent.height;
                prefs: root.prefs;
                jump-to: root.settings-jump;
                category <=> root.settings-category;
                tools: root.tools;
                writable: root.settings-writable;
                error: root.settings-error;
                profile-path: root.profile-path;
                build-label: root.build-label;
                library-limit: root.library-limit;
                storage-used: root.storage-used;
                app-size: root.app-size;
                workspace-size: root.workspace-size;
                components: root.components;
                folders: root.folders;
                motion-duration: root.motion-duration;
                set-pref(key, value) => { root.set-pref(key, value); }
                set-tool-enabled(id, on) => { root.set-tool-enabled(id, on); }
                action(name) => { root.dock-action(name); }
            }
        }

        // Top bar: title, notice, the page's actions, the global actions (§7). Drawn after the page so its
        // tooltips sit above it.
        if root.diagnostic-scene != 0 : Rectangle {
            x: root.side;
            y: 0px;
            width: parent.width - root.side;
            height: Theme.bar;
            background: Theme.chrome;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.page <= 1 ? "Workspace" : root.page == 3 ? "Settings" : "";
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if root.page <= 1 && root.library-mode == 1 : Text {
                        text: root.section-name == "" ? "· Sections" : "· Sections · " + root.section-name;
                        color: Theme.subtle;
                        font-size: Theme.font-title;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 280px;
                    }
                }

                // Notice: one line after the title, closed with its ✕
                Rectangle {
                    horizontal-stretch: 1;
                    if root.notice != "" : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: root.notice;
                            color: Theme.muted;
                            font-size: Theme.font-body;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        VerticalLayout {
                            alignment: center;
                            BarButton {
                                icon: "";
                                label: "Dismiss: " + root.notice;
                                activated => { root.dismiss-notice(); }
                                Text {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    text: "✕";
                                    color: Theme.subtle;
                                    font-size: 11px;
                                }
                            }
                        }
                    }
                }

                // The page's actions
                if root.page <= 1 && root.library-mode == 0 : HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        SearchField {
                            placeholder: "Search your files...";
                            label: "Search your files";
                            text: root.library-query;
                            edited(value) => { root.set-query(value); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        AppButton {
                            small: true;
                            icon: "upload";
                            text: "Add";
                            enabled: root.library-loaded && root.library-writable && !root.library-busy;
                            clicked => { root.choose-reference(); }
                        }
                    }
                }
                if root.page == 3 : HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        // Enter opens the category that holds the words (Rust matches them)
                        SearchField {
                            placeholder: "Search settings...";
                            label: "Search settings";
                            accepted(value) => {
                                let found = root.search-settings(value);
                                if (found >= 0) {
                                    root.settings-category = found;
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        AppButton {
                            quiet: true;
                            small: true;
                            icon: "rotate-ccw";
                            text: "Restore defaults";
                            enabled: root.settings-writable;
                            clicked => { root.reset-settings(); }
                        }
                    }
                }

                if root.prefs.show-dock : VerticalLayout {
                    alignment: center;
                    TopActions {
                        busy: root.jobs-busy;
                        activity => { root.dock-action("activity"); }
                        shortcuts => { root.dock-action("shortcuts"); }
                        open-folder => { root.dock-action("folder"); }
                        language => { root.dock-action("language"); }
                        save-session => { root.dock-action("session"); }
                    }
                }
            }
        }

        // Sidebar, the full height of the window (§6); drawn last so its tooltips sit above the page
        if root.diagnostic-scene != 0 : Rectangle {
            x: 0px;
            y: 0px;
            width: root.side;
            height: parent.height;
            background: Theme.chrome;
            clip: false;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.line;
            }

            // Header: as tall as the top bar, with the same line under it
            Rectangle {
                y: 0px;
                height: Theme.bar;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
                Image {
                    x: root.rail-open ? 14px : (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 14px;
                    source: Assets.mark;
                    image-fit: contain;
                }
                if root.rail-open : Text {
                    x: 50px;
                    y: (parent.height - self.height) / 2;
                    text: "Halation";
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: 600;
                }
                TouchArea {
                    width: root.rail-open ? 120px : parent.width;
                    mouse-cursor: pointer;
                    clicked => { root.navigate(0); }
                }
                if root.rail-open : BarButton {
                    x: parent.width - self.width - 9px;
                    y: (parent.height - self.height) / 2;
                    icon: "panel-left-close";
                    label: "Collapse the sidebar (Ctrl+B)";
                    activated => { root.rail-open = false; }
                }
            }

            VerticalLayout {
                y: Theme.bar;
                height: parent.height - Theme.bar;
                padding: 8px;
                padding-right: 9px;
                spacing: 0px;
                // The rows grow with the window's height, up to 54 px, and the group headers and the gap above Settings take all that is left, so
                // the list fills the sidebar instead of leaving a dead band above Settings

                SidebarItem {
                    icon: "house";
                    label: "Workspace";
                    open: root.rail-open;
                    active: root.page <= 1;
                    activated => { root.navigate(0); }
                }
                for tool[index] in root.active-tools : VerticalLayout {
                    spacing: 0px;
                    vertical-stretch: tool.id == "library" ? 0 : 1;
                    if tool.id != "library" && (index == 0 || tool.group != root.active-tools[index - 1].group) : SidebarGroup {
                        label: root.group-name(tool.group);
                        open: root.rail-open;
                    }
                    if tool.id != "library" : SidebarItem {
                        icon: tool.icon;
                        label: tool.name;
                        open: root.rail-open;
                        activated => { root.tool-activated(tool.id); }
                    }
                }

                // Foot: Settings, and the toggle while collapsed, under a line; in the same layout so the rows match
                Rectangle {
                    min-height: 7px;
                    vertical-stretch: 1;
                    Rectangle {
                        y: parent.height - 7px;
                        height: 1px;
                        background: Theme.line;
                    }
                }
                if !root.rail-open : SidebarItem {
                    icon: "panel-left-open";
                    label: "Expand the sidebar (Ctrl+B)";
                    open: false;
                    activated => { root.rail-open = true; }
                }
                SidebarItem {
                    icon: "settings";
                    label: "Settings";
                    open: root.rail-open;
                    active: root.page == 3;
                    activated => { root.navigate(3); }
                }
            }
        }
    }
}
