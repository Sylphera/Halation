import { Theme } from "../theme.slint";
import { ToolIcon } from "../icons.slint";
import { ToolTile } from "../components/tool-tile.slint";
import { AppButton } from "../components/button.slint";
import { ToolItem, RecentItem } from "../models.slint";

export component HomePage inherits Rectangle {
    in property <[ToolItem]> tools;
    in property <[RecentItem]> recent;
    in property <bool> library-loaded: false;
    in property <int> library-total: 0;
    in property <string> notice: "";
    in property <duration> motion-duration: 160ms;

    callback tool-activated(string);
    callback choose-reference();
    callback file-dropped(data-transfer);
    callback dismiss-notice();
    callback open-library();

    background: transparent;

    // Static, low-cost atmosphere. No shader, timer or animated background.
    Rectangle {
        x: -170px;
        y: -180px;
        width: 760px;
        height: 760px;
        border-radius: 380px;
        background: #1a1a23;
        opacity: 0.28;
    }
    Rectangle {
        x: parent.width - 520px;
        y: parent.height - 500px;
        width: 820px;
        height: 820px;
        border-radius: 410px;
        background: #22222d;
        opacity: 0.20;
    }

    Rectangle {
        x: parent.width - 102px;
        y: 16px;
        width: 84px;
        height: 24px;
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        Text {
            text: "BETA BUILD";
            color: Theme.muted;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.8px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    VerticalLayout {
        padding: 22px;
        spacing: 12px;
        alignment: center;

        Image {
            source: @image-url("../../assets/halation-mark.png");
            width: 154px;
            height: 76px;
            image-fit: contain;
        }

        Text {
            text: "HALATION";
            color: Theme.text;
            font-size: 38px;
            font-weight: 800;
            letter-spacing: 7px;
            horizontal-alignment: center;
        }

        Text {
            text: "Take your time. Everything else is instant.";
            color: Theme.muted;
            font-size: 13px;
            horizontal-alignment: center;
        }

        Rectangle {
            width: min(980px, root.width - 48px);
            height: 66px;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding: 7px;
                spacing: 2px;
                for tool in root.tools : ToolTile {
                    horizontal-stretch: 1;
                    id: tool.id;
                    name: tool.name;
                    icon: tool.icon;
                    available: tool.available;
                    motion-duration: root.motion-duration;
                    activated => { root.tool-activated(tool.id); }
                }
            }
        }

        Rectangle {
            height: 22px;
            width: min(980px, root.width - 48px);
            background: transparent;
            if root.notice != "" : Rectangle {
                width: parent.width;
                height: parent.height;
                border-radius: 11px;
                background: Theme.accent-soft;
                Text {
                    text: root.notice;
                    color: Theme.accent;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.dismiss-notice(); }
                }
            }
            if root.notice == "" : Text {
                text: "Only Library is available in this beta. Processing engines are not connected.";
                color: Theme.muted;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: min(610px, root.width - 48px);
            height: 112px;
            border-radius: 16px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                alignment: center;
                spacing: 5px;
                ToolIcon {
                    name: "upload";
                    tint: Theme.muted;
                }
                Text {
                    text: "Drop a song or an image";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: "or click to browse. References stay where they are.";
                    color: Theme.muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }

            FocusScope {
                width: parent.width;
                height: parent.height;
                focus-on-tab-navigation: true;
                accessible-role: button;
                accessible-label: "Add a song or image reference";
                accessible-action-default => { root.choose-reference(); }
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space) {
                        root.choose-reference();
                        accept
                    } else {
                        reject
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        parent.focus();
                        root.choose-reference();
                    }
                }
            }

            DropArea {
                can-drop(event) => { DragAction.copy }
                dropped(event) => {
                    root.file-dropped(event.data);
                    event.proposed-action
                }
            }
        }

        Rectangle {
            width: min(610px, root.width - 48px);
            height: 42px;
            border-radius: 12px;
            background: transparent;
            border-width: 1px;
            border-color: Theme.border;

            HorizontalLayout {
                padding: 8px;
                spacing: 10px;
                Text {
                    text: "RECENT FILES";
                    color: Theme.muted;
                    font-size: 9px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.recent.length == 0 : Text {
                    text: root.library-loaded ? "Nothing yet — add a reference above." : "Loading references…";
                    color: Theme.muted;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.recent.length > 0 : HorizontalLayout {
                    spacing: 10px;
                    for item in root.recent : Text {
                        text: item.name;
                        color: Theme.text;
                        font-size: 10px;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 130px;
                    }
                }
                AppButton {
                    text: "Open Library";
                    compact: true;
                    clicked => { root.open-library(); }
                }
            }
        }
    }
}
