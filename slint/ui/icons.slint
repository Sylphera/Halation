export component ToolIcon inherits Rectangle {
    in property <string> name: "download";
    in property <color> tint: #f4f4f5;
    width: 18px;
    height: 18px;

    if name == "mark" : Image {
        source: @image-url("../assets/halation-mark.png");
        width: 26px;
        height: 13px;
        image-fit: contain;
    }
    if name == "home" : IconHome { tint: root.tint; }
    if name == "download" : IconDownload { tint: root.tint; }
    if name == "convert" : IconConvert { tint: root.tint; }
    if name == "vocal" : IconVocal { tint: root.tint; }
    if name == "visualizer" : IconVisualizer { tint: root.tint; }
    if name == "grade" : IconGrade { tint: root.tint; }
    if name == "cover" : IconCover { tint: root.tint; }
    if name == "removebg" : IconRemoveBg { tint: root.tint; }
    if name == "upscale" : IconUpscale { tint: root.tint; }
    if name == "interp" : IconInterp { tint: root.tint; }
    if name == "framegrab" : IconFrameGrab { tint: root.tint; }
    if name == "library" : IconLibrary { tint: root.tint; }
    if name == "jobs" : IconJobs { tint: root.tint; }
    if name == "settings" : IconSettings { tint: root.tint; }
    if name == "upload" : IconUpload { tint: root.tint; }
    if name == "search" : IconSearch { tint: root.tint; }
    if name == "warning" : IconWarning { tint: root.tint; }
}
