import { Theme } from "../theme.slint";
import { ToolIcon } from "../icons.slint";
import { Motion, Curve } from "../motion.slint";
import { Tooltip } from "tooltip.slint";

// A 28 px icon button of the top bar, with a tooltip below it
export component BarButton inherits FocusScope {
    in property <string> icon;
    in property <string> label;
    callback activated;
    width: 28px;
    height: 28px;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { activated(); }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == Key.Space) {
            activated();
            accept
        } else {
            reject
        }
    }
    Rectangle {
        border-radius: Theme.radius-control;
        background: touch.pressed ? Theme.control-active : (touch.has-hover ? Theme.control-hover : Theme.control-hover.transparentize(1));
        animate background { duration: touch.pressed ? 0ms : Motion.hover(touch.has-hover); easing: Curve.ease; }
        border-width: root.has-focus ? 2px : 0px;
        border-color: Theme.accent;
    }
    content := Rectangle {
        // Sinks at once on press, back on release
        transform-scale: touch.pressed ? Motion.press-scale : 100%;
        animate transform-scale-x, transform-scale-y { duration: touch.pressed ? 0ms : Motion.release; easing: Curve.ease; }
        @children
        if root.icon != "" : ToolIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.icon;
            size: 16px;
            tint: touch.has-hover ? Theme.text : Theme.muted;
            animate tint { duration: Motion.hover(touch.has-hover); easing: Curve.ease; }
        }
    }
    Tooltip {
        x: parent.width - self.width;
        y: parent.height + 8px;
        text: root.label;
        show: touch.has-hover || root.has-focus;
        at-once: root.has-focus;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

// The global actions at the right of the top bar: activity, keyboard shortcuts, the Halation folder, language and
// saving the session
export component TopActions inherits HorizontalLayout {
    in property <bool> busy: false;
    callback activity();
    callback shortcuts();
    callback open-folder();
    callback language();
    callback save-session();

    spacing: 2px;
    alignment: end;

    BarButton {
        icon: "";
        label: root.busy ? "Activity: working" : "Activity: all quiet";
        activated => { root.activity(); }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.busy ? Theme.activity : Theme.subtle;
        }
    }
    BarButton { icon: "keyboard"; label: "Keyboard shortcuts (?)"; activated => { root.shortcuts(); } }
    BarButton { icon: "folder-open"; label: "Halation folder"; activated => { root.open-folder(); } }
    BarButton { icon: "globe"; label: "Language"; activated => { root.language(); } }
    BarButton { icon: "save"; label: "Save Session"; activated => { root.save-session(); } }
}
