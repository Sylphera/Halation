import { Theme } from "../theme.slint";
import { ToolIcon } from "../icons.slint";
import { Motion, Curve } from "../motion.slint";
import { Tooltip } from "tooltip.slint";
import { Surface, Level } from "surface.slint";

// A 32 px icon button of the top bar, with a tooltip below it. Hovered or pressed it is a raised piece of the material,
// as the sidebar's rows are (Java, 2026-10-22)
export component BarButton inherits FocusScope {
    // The focus ring shows for keyboard focus only, not after a click
    property <bool> keyboard-focus: false;
    focus-gained(reason) => {
        self.keyboard-focus = reason == FocusReason.tab-navigation;
    }
    focus-lost => {
        self.keyboard-focus = false;
    }
    in property <string> icon;
    in property <string> label;
    // Its shortcut, shown as a key cap in the tooltip
    in property <string> key: "";
    callback activated;
    width: 32px;
    height: 32px;
    focus-on-tab-navigation: true;
    accessible-role: button;
    accessible-label: root.key != "" ? root.label + " (" + root.key + ")" : root.label;
    accessible-action-default => { activated(); }
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == Key.Space) {
            activated();
            accept
        } else {
            reject
        }
    }
    property <float> rest: touch.has-hover || touch.pressed ? 0 : 1;
    animate rest { duration: touch.pressed ? 0ms : Motion.hover(touch.has-hover); easing: Curve.ease; }
    Surface {
        level: Level.raised;
        pressed: touch.pressed;
        clear: root.rest;
    }
    Rectangle {
        border-radius: Theme.radius-control;
        border-width: root.keyboard-focus ? 2px : 0px;
        border-color: Theme.accent;
    }
    content := Rectangle {
        // Sinks at once on press, back on release
        // Both axes set explicitly: animating them with only the `transform-scale` shorthand set leaves them at 0 (Slint 1.18)
        transform-scale-x: touch.pressed ? Motion.press-scale : 100%;
        transform-scale-y: self.transform-scale-x;
        animate transform-scale-x, transform-scale-y { duration: touch.pressed ? 0ms : Motion.release; easing: Curve.ease; }
        @children
        if root.icon != "" : ToolIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.icon;
            size: 17px;
            tint: touch.has-hover ? Theme.text : Theme.muted;
            animate tint { duration: Motion.hover(touch.has-hover); easing: Curve.ease; }
        }
    }
    Tooltip {
        x: parent.width - self.width;
        y: parent.height + 8px;
        text: root.label;
        key: root.key;
        show: touch.has-hover || root.keyboard-focus;
        at-once: root.keyboard-focus;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

// Activity: a dot, lit while jobs run, beside the page's name in the top bar
export component ActivityButton inherits BarButton {
    in property <bool> busy: false;
    icon: "";
    label: root.busy ? "Activity: working" : "Activity: all quiet";
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.busy ? Theme.activity : Theme.subtle;
    }
}

// The global actions at the right of the top bar: keyboard shortcuts, the Halation folder, language and saving the
// session
export component TopActions inherits HorizontalLayout {
    callback shortcuts();
    callback open-folder();
    callback language();
    callback save-session();

    spacing: 6px;
    alignment: end;

    BarButton { icon: "keyboard"; label: "Keyboard shortcuts"; key: "?"; activated => { root.shortcuts(); } }
    BarButton { icon: "folder-open"; label: "Halation folder"; activated => { root.open-folder(); } }
    BarButton { icon: "globe"; label: "Language"; activated => { root.language(); } }
    BarButton { icon: "save"; label: "Save Session"; activated => { root.save-session(); } }
}
