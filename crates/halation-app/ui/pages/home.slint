import { Theme } from "../theme.slint";
import { ToolIcon } from "../icons.slint";
import { AppButton } from "../components/button.slint";
import { LibraryRow, SectionRow, ItemRow, JobRow } from "../models.slint";
import { FilesBlock } from "library.slint";
import { ListView } from "std-widgets.slint";

// A small text link of a block heading
component HeadLink inherits Rectangle {
    in property <string> text;
    callback activated;
    width: link-text.preferred-width + 8px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.activated(); }
    link-text := Text {
        x: 4px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        color: link-touch.has-hover ? Theme.text : Theme.subtle;
        font-size: Theme.font-small;
        font-weight: 500;
    }
    link-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

// The Workspace: Home, the Library and the jobs in one page (Java, 2026-10-22). Over the Drape, top to bottom: the
// drop line, "Your files" (the Library, which takes the height left), and the jobs. No header of its own: the
// sidebar and the top bar already carry the mark, the name and the page's title.
export component WorkspacePage inherits Rectangle {
    in property <[LibraryRow]> rows;
    in property <int> total: 0;
    in property <int> missing: 0;
    in property <bool> loaded: false;
    in property <bool> busy: false;
    in property <bool> writable: false;
    in property <string> error: "";
    in property <[SectionRow]> sections;
    in property <[ItemRow]> section-items;
    in property <string> section-name: "";
    in property <string> section-kind: "";
    in property <string> section-id: "";
    in property <int> section-hidden: 0;
    in property <bool> sections-loaded: false;
    in property <bool> sections-busy: false;
    in property <[JobRow]> jobs;
    in property <bool> jobs-has-finished: false;
    in property <duration> motion-duration: 160ms;
    in-out property <int> mode: 0;

    callback choose-reference();
    callback file-dropped(data-transfer);
    callback remove-reference(string);
    callback select-section(string);
    callback create-section(string);
    callback rename-section(string, string);
    callback delete-section(string);
    callback link-folder();
    callback unlink-folder(string);
    callback sections-opened();
    callback open-activity();
    callback cancel-job(string);
    callback clear-finished-jobs();

    // Rows the jobs block shows before it scrolls
    property <int> job-rows: min(3, max(1, root.jobs.length));

    VerticalLayout {
        x: max(32px, (root.width - 1200px) / 2);
        width: root.width - 2 * self.x;
        padding-top: 24px;
        padding-bottom: 20px;
        spacing: 24px;

        // Drop line: the page's first action
        Rectangle {
            height: 88px;
            border-radius: Theme.radius-overlay;
            border-width: 1px;
            border-color: drop-area.has-drag || drop-focus.has-focus ? Theme.accent : Theme.line-strong;
            background: drop-area.has-drag ? #a3a8dc1f : (drop-touch.has-hover ? Theme.hover-fill : transparent);
            animate background { duration: root.motion-duration; easing: ease-out; }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    ToolIcon {
                        name: "upload";
                        size: 18px;
                        tint: drop-area.has-drag ? Theme.accent : Theme.muted;
                    }
                }
                Text {
                    text: drop-area.has-drag ? "Drop to add them to your files" : "Drop files here";
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Or click to browse. Files stay where they are, never copied.";
                    color: Theme.subtle;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                }
            }
            drop-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    drop-focus.focus();
                    root.choose-reference();
                }
            }
            drop-focus := FocusScope {
                width: 0px;
                height: 0px;
                focus-on-tab-navigation: true;
                accessible-role: button;
                accessible-label: "Drop files here, or click to browse";
                accessible-action-default => { root.choose-reference(); }
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space) {
                        root.choose-reference();
                        accept
                    } else {
                        reject
                    }
                }
            }
            drop-area := DropArea {
                can-drop(event) => { DragAction.copy }
                dropped(event) => {
                    root.file-dropped(event.data);
                    event.proposed-action
                }
            }
        }

        FilesBlock {
            vertical-stretch: 1;
            min-height: 180px;
            rows: root.rows;
            total: root.total;
            missing: root.missing;
            loaded: root.loaded;
            busy: root.busy;
            writable: root.writable;
            error: root.error;
            motion-duration: root.motion-duration;
            mode <=> root.mode;
            sections: root.sections;
            section-items: root.section-items;
            section-id: root.section-id;
            section-name: root.section-name;
            section-kind: root.section-kind;
            section-hidden: root.section-hidden;
            sections-loaded: root.sections-loaded;
            sections-busy: root.sections-busy;
            sections-opened => { root.sections-opened(); }
            select-section(id) => { root.select-section(id); }
            create-section(name) => { root.create-section(name); }
            rename-section(id, name) => { root.rename-section(id, name); }
            delete-section(id) => { root.delete-section(id); }
            link-folder => { root.link-folder(); }
            unlink-folder(id) => { root.unlink-folder(id); }
            remove-reference(id) => { root.remove-reference(id); }
        }

        // Jobs: up to three rows, then the list scrolls
        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 36px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "Jobs";
                        color: Theme.text;
                        font-size: Theme.font-title;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if root.jobs.length > 0 : Text {
                        text: "" + root.jobs.length;
                        color: Theme.subtle;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.jobs-has-finished : HeadLink {
                        text: "Clear finished";
                        activated => { root.clear-finished-jobs(); }
                    }
                    HeadLink {
                        text: "View history";
                        activated => { root.open-activity(); }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
            }
            if root.jobs.length == 0 : Text {
                height: 48px;
                text: "No jobs. This beta has no engines connected yet, so nothing runs.";
                color: Theme.subtle;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.jobs.length > 0 : ListView {
                height: root.job-rows * 48px;
                for job in root.jobs : Rectangle {
                    height: 48px;
                    width: parent.width;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                Rectangle {
                                    x: 4px;
                                    y: 4px;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: job.failed ? Theme.danger : job.finished ? Theme.success : Theme.activity;
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: job.name;
                                color: Theme.text;
                                font-size: Theme.font-body;
                                font-weight: 500;
                                overflow: elide;
                            }
                            Text {
                                text: job.state + (job.detail != "" ? " · " + job.detail : "");
                                color: job.failed ? Theme.danger : Theme.subtle;
                                font-size: Theme.font-small;
                                overflow: elide;
                            }
                        }
                        if job.has-progress && !job.finished : VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 120px;
                                height: 4px;
                                border-radius: 2px;
                                background: Theme.control-active;
                                Rectangle {
                                    x: 0px;
                                    width: parent.width * clamp(job.progress, 0, 1);
                                    border-radius: 2px;
                                    background: Theme.activity;
                                }
                            }
                        }
                        if job.cancellable : VerticalLayout {
                            alignment: center;
                            AppButton {
                                small: true;
                                quiet: true;
                                text: "Cancel";
                                clicked => { root.cancel-job(job.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}
